{
  "backend": "local-markdown",
  "defaultPickFrom": "Agent queue",
  "defaultPickTo": "In Progress",
  "defaultFinishTo": "Done",
  "leaseMinutes": 60,
  "archive": {
    "onStatuses": [
      "Done"
    ]
  },
  "web": {
    "protectNonHumanClaims": true
  },
  "worker": {
    "defaultAgent": null,
    "workspaceMode": "current",
    "agentPermissions": "workspace",
    "completion": {
      "commit": "inspect",
      "integration": "none"
    },
    "worktreeRoot": "{repoParent}/{repo}.worktrees",
    "branchFormat": "wrighty-worker/{id}-{title}",
    "worktreeNameFormat": "{id}-{title}"
  },
  "localMarkdown": {
    "path": ".wrighty",
    "statuses": [
      "Todo",
      "Agent queue",
      "In Progress",
      "Done"
    ],
    "priorities": [
      "P0",
      "P1",
      "P2",
      "P3"
    ]
  }
}
