@model ItemPageModel
<article class="detail edit-detail" data-item-id="@Model.Id">
  <header class="detail-header"><div><span class="display-id">@Model.DisplayId</span><h2 tabindex="-1">Edit work item</h2></div><button type="button" class="close-panel" aria-label="Close details">×</button></header>
  @if (Model.Notice is not null){<p class="notice" role="status">@Model.Notice</p>}
  @if (Model.ErrorCode is not null){<p class="error" role="alert"><strong>@Model.ErrorCode</strong> @Model.ErrorMessage</p>}
  <p id="stale-edit-notice" class="notice" role="status" hidden>The dashboard changed while this draft was open. Save will verify that this item is still current.</p>
  <partial name="_ResumeAddress" model="Model" />
  <form class="edit-form" hx-post="/?handler=Save" hx-target="#item-panel" hx-swap="innerHTML" data-has-resume-address="@Model.HasResumeAddress.ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id">
    <input type="hidden" name="expectedRevision" value="@Model.Revision">
    <input type="hidden" name="expectedClaimGeneration" value="@Model.ClaimGeneration">
    <label>Title <input name="title" value="@Model.Title" maxlength="256" required></label>
    <label>Status <select name="status">@foreach(var status in Model.Statuses){<option value="@status" selected="@(string.Equals(status, Model.Status, StringComparison.OrdinalIgnoreCase))">@status</option>}</select></label>
    <label>Priority <select name="priority"><option value="">None</option>@foreach(var priority in Model.Priorities){<option value="@priority" selected="@(string.Equals(priority, Model.Priority, StringComparison.OrdinalIgnoreCase))">@priority</option>}</select></label>
    <fieldset class="worker-settings">
      <legend>Execution policy</legend>
      <label class="checkbox-field">
        <input type="checkbox" name="automaticExecutionAllowed" value="true" checked="@Model.AutomaticExecutionAllowed">
        <span><strong>Allow automatic execution</strong><small>Workers ignore the item when this is off.</small></span>
      </label>
      @if (Model.DispatchState == DispatchStates.RetryScheduled && Model.HasResumeAddress)
      {
        <label>Agent policy
          <select aria-describedby="agent-policy-locked-help" disabled>
            <option value="">No item preference</option>
            @foreach (var agent in new[] { "claude", "codex", "copilot" })
            {
              <option value="@agent" selected="@(string.Equals(agent, Model.AgentPolicy, StringComparison.OrdinalIgnoreCase))">@char.ToUpperInvariant(agent[0])@agent[1..]</option>
            }
          </select>
          <input type="hidden" name="agentPolicy" value="@Model.AgentPolicy">
          <small id="agent-policy-locked-help">
            Locked while the retained @Model.ResumeAgentLabel session is scheduled to retry.
            Changing vendors requires an explicit cross-agent handoff, which is not available yet.
          </small>
        </label>
        <p class="handback-hint">
          Ordinary saves and releases preserve the scheduled retry. Moving the item out of its
          active worker status, preventing automatic execution, queueing it now, handing it back,
          or finishing it cancels or overrides the timer explicitly.
        </p>
      }
      else
      {
        <label>Agent policy
          <select name="agentPolicy">
            <option value="">No item preference</option>
            @foreach (var agent in new[] { "claude", "codex", "copilot" })
            {
              <option value="@agent" selected="@(string.Equals(agent, Model.AgentPolicy, StringComparison.OrdinalIgnoreCase))">@char.ToUpperInvariant(agent[0])@agent[1..]</option>
            }
          </select>
          <small>A worker-level <code>--agent</code> overrides this policy.</small>
        </label>
      }
    </fieldset>
    <label>Markdown body <textarea name="body" rows="18">@Model.Body</textarea></label>
    @if (Model.HasResumeAddress && Model.ResumeAgentLabel is not null)
    {
      <p class="handback-hint"><strong>Save and resume automatically</strong> queues the recorded session. A running continuous worker will resume it. To continue it yourself, use <strong>Save and show manual @Model.ResumeAgentLabel resume command</strong> under <strong>More actions…</strong></p>
    }
    @if (Model.CardEntry)
    {
      @* Opened as a card gesture, so it ends like one: both ways out release the claim. The full
         set below is right when the operator is working inside the panel, but here Save is the
         button they will reach for, and a plain save would keep the claim and take the card's own
         Edit action away. *@
      <input type="hidden" name="fromCard" value="true">
      <div class="actions edit-actions">
        <div class="actions-secondary">
          <button class="has-tooltip" name="action" value="release" formnovalidate aria-describedby="card-cancel-help" data-tooltip="Discard this draft and release the claim. Nothing is saved.">Cancel</button>
          <span id="card-cancel-help" class="visually-hidden">Discard this draft and release the claim. Nothing is saved.</span>
        </div>
        <div class="actions-primary">
          <button class="primary has-tooltip" name="action" value="save-release" aria-describedby="card-save-help" data-tooltip="Save these changes and release the claim, returning to the board.">Save</button>
          <span id="card-save-help" class="visually-hidden">Save these changes and release the claim, returning to the board.</span>
        </div>
      </div>
    }
    else
    {
    <div class="actions edit-actions">
      <div class="actions-secondary">
        <button class="has-tooltip" name="action" value="release" formnovalidate aria-describedby="edit-release-help" data-tooltip="Discard this draft and release the claim without saving field changes. A recorded agent session remains available for later resume.">Release without saving</button>
        <span id="edit-release-help" class="visually-hidden">Discard this draft and release the claim without saving field changes. A recorded agent session remains available for later resume.</span>
        <button type="button" class="cancel-edit">Cancel</button>
      </div>
      <div class="actions-primary">
        @if (Model.HasResumeAddress)
        {
          <details class="action-menu">
            <summary>More actions…</summary>
            <div class="action-menu-popover">
              <button class="has-tooltip" name="action" value="save-release" aria-describedby="save-release-help" data-tooltip="Save these changes and release the claim. The recorded agent session remains available for later resume." data-confirm-title="Save changes and release this claim?" data-confirm-message="The item returns to the pool; the recorded agent session remains available." data-confirm-action="Save and release">Save and release</button>
              <span id="save-release-help" class="visually-hidden">Save these changes and release the claim. The recorded agent session remains available for later resume.</span>
              @if (Model.ResumeAgentLabel is not null)
              {
                <button class="has-tooltip" name="action" value="save-handback" aria-describedby="handback-help" data-tooltip="Save these changes and show a command; this does not start @Model.ResumeAgentLabel. For automatic continuation by a running worker, use “Save and resume automatically.”" data-confirm-title="Hand this session back?" data-confirm-message="Confirm that any Desktop or CLI session is stopped or idle. Continuing in two clients at once can fork or corrupt vendor conversation history." data-confirm-action="Save and hand back">Save and show manual @Model.ResumeAgentLabel resume command</button>
                <span id="handback-help" class="visually-hidden">Save these changes and show a command; this does not start @Model.ResumeAgentLabel. For automatic continuation by a running worker, use Save and resume automatically.</span>
              }
            </div>
          </details>
        }
        else
        {
          <button class="has-tooltip" name="action" value="save-release" aria-describedby="save-release-help" data-tooltip="Save these changes, then release the claim for another claimant.">Save and release</button>
          <span id="save-release-help" class="visually-hidden">Save these changes, then release the claim for another claimant.</span>
        }
        <button class="has-tooltip" name="action" value="finish" aria-describedby="finish-help" data-tooltip="Save these changes, move the item to the configured finished status, and release its claim.">Finish</button>
        <span id="finish-help" class="visually-hidden">Save these changes, move the item to the configured finished status, and release its claim.</span>
        <button name="action" value="save">Save</button>
        @if (Model.HasResumeAddress && Model.ResumeAgentLabel is not null)
        {
          <button id="session-hand-back-worker" class="primary has-tooltip" name="action" value="save-queue" aria-describedby="queue-help" data-tooltip="Save these changes and queue this session. A running continuous worker will resume it. To continue it yourself, use “Save and show manual @Model.ResumeAgentLabel resume command” under More actions." data-confirm-title="Hand this session back to a worker?" data-confirm-message="Confirm that the Desktop or CLI session is stopped or idle. Continuing in two clients at once can fork or corrupt vendor conversation history." data-confirm-action="Save and resume automatically">Save and resume automatically</button>
          <span id="queue-help" class="visually-hidden">Save these changes and queue this session. A running continuous worker will resume it. To continue it yourself, use Save and show manual @Model.ResumeAgentLabel resume command under More actions.</span>
        }
      </div>
    </div>
    }
  </form>
</article>
