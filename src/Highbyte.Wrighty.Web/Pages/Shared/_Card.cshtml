@model BoardCardModel
@{
  var claimClass = Model.ClaimState switch
  {
    ClaimOwnershipState.OwnedByCurrent => "claimed claimed-current",
    ClaimOwnershipState.HeldByOther => "claimed claimed-other",
    _ => string.Empty
  };
  var activityClass = Model.OperationalStatus switch
  {
    OperationalStatuses.NeedsAttention => "activity-needs-attention",
    OperationalStatuses.AgentActive => "activity-agent-active",
    OperationalStatuses.Queued => "activity-queued",
    OperationalStatuses.RetryScheduled => "activity-retry-scheduled",
    OperationalStatuses.HandoffQueued => "activity-handoff-queued",
    OperationalStatuses.PausedSession => "activity-paused",
    OperationalStatuses.Completed => "activity-completed",
    _ => string.Empty
  };
  var activityLabel = OperationalStatusDisplay.Label(Model.OperationalStatus, Model.AgentLabel);
  var providerBlocked = Model.ProviderBlock is not null;
  if (providerBlocked)
  {
    activityClass = $"{activityClass} provider-blocked".Trim();
    activityLabel = Model.ProviderBlock!.HasCapacityFailure
      ? $"{Model.ProviderBlock.AgentLabel} unavailable"
      : $"{Model.ProviderBlock.AgentLabel} probe active";
  }
}
@* Razor omits an attribute whose value is null, which is how a non-draggable card loses its
   draggable attribute entirely rather than carrying an encoded one. *@
<div class="card-wrap" draggable="@(Model.IsDraggable ? "true" : null)" data-drag-item="@Model.Id"
     data-drag-targets="@string.Join("\u001f", Model.EffectiveDropTargets)">
  <button type="button" class="card @claimClass @activityClass" title="@Model.Title" data-item-id="@Model.Id"
          data-filter-text="@Model.DisplayId @Model.Title @Model.Status @Model.Priority @Model.ClaimantKindLabel @Model.AgentLabel @activityLabel @Model.ProviderBlock?.Reason"
          hx-get="/?handler=Item&amp;id=@Uri.EscapeDataString(Model.Id)"
          hx-target="#item-panel" hx-swap="innerHTML">
    <span class="card-top"><span class="display-id">@Model.DisplayId</span>@if (Model.Priority is not null){<span class="priority">@Model.Priority</span>}</span>
    <span class="card-title">@Model.Title</span>
    @* The claim label shares the badge's row, pushed right. The bottom of the card belongs to the
       action buttons, which are positioned over it; leaving the claim state down there put quiet,
       always-present text underneath controls that grow with the item's state. *@
    <span class="card-status-row">
      @if (activityLabel is not null)
      {
        <span class="activity-badge">@activityLabel</span>
      }
      <span class="card-claim">@Model.ClaimLabel@if (Model.Archived){<text> · Archived</text>}</span>
    </span>
    @if (Model.ClaimantKindLabel is not null || Model.HasRecordedWorktree)
    {
      <span class="card-meta">
        @if (Model.ClaimantKindLabel is not null){<span class="claimant-badge">@(Model.AgentLabel ?? Model.ClaimantKindLabel)</span>}
        @if (Model.HasRecordedWorktree){<span class="worktree-badge" title="A worker worktree is recorded for this item">⌥ worktree</span>}
      </span>
    }
  </button>
  <partial name="Shared/_CardActions"
           model="new ActionListView(Model.Id, Model.DisplayId, Model.EffectiveActions)" />
</div>
