@model Highbyte.Wrighty.Web.SettingsPageModel
@using System.Globalization
@using System.Text.Json
@using Highbyte.Wrighty.Configuration
<section id="settings-content"
         class="settings"
         aria-live="polite"
         hx-request='{"timeout":130000}'>
  <header class="operations-heading">
    <div>
      <span class="eyebrow">SETTINGS</span>
      <h2>Settings</h2>
    </div>
    <div class="target-actions">
      <button id="refresh-settings"
              class="request-button"
              type="button"
              hx-get="/?handler=Settings"
              hx-target="#settings-content"
              hx-swap="outerHTML"
              hx-indicator="this"
              hx-disabled-elt="this">
        <span class="request-button-idle">Refresh settings</span>
        <output class="request-button-progress">
          <span class="request-button-spinner" aria-hidden="true"></span>
          Refreshing…
        </output>
      </button>
    </div>
  </header>

  @if (Model.Notice is not null)
  {
    <output id="configuration-save-notice" class="notice">@Model.Notice</output>
  }
  @if (Model.ConfigurationErrorCode is not null)
  {
    <div id="configuration-validation-summary" class="error" role="alert"><strong>@Model.ConfigurationErrorCode</strong> @Model.ConfigurationErrorMessage</div>
  }

  @{
    var activeSection = Model.ActiveSection;
    if (activeSection == "user" && Model.UserConfiguration is null) activeSection = "repository";
    if (activeSection == "storage" && Model.StorageLocations.Count == 0) activeSection = "repository";
  }
  <div class="settings-layout">
    <nav id="settings-sections" class="settings-sections" role="tablist"
         aria-label="Settings sections">
      <button id="settings-tab-repository" class="settings-section-button@(activeSection == "repository" ? " active" : "")"
              type="button" role="tab" aria-selected="@(activeSection == "repository" ? "true" : "false")"
              tabindex="@(activeSection == "repository" ? "0" : "-1")"
              aria-controls="settings-repository-panel">Repository</button>
      @if (Model.UserConfiguration is not null)
      {
        <button id="settings-tab-user" class="settings-section-button@(activeSection == "user" ? " active" : "")"
                type="button" role="tab" aria-selected="@(activeSection == "user" ? "true" : "false")"
                tabindex="@(activeSection == "user" ? "0" : "-1")"
                aria-controls="settings-user-panel">User</button>
      }
      @if (Model.StorageLocations.Count > 0)
      {
        <button id="settings-tab-storage" class="settings-section-button@(activeSection == "storage" ? " active" : "")"
                type="button" role="tab" aria-selected="@(activeSection == "storage" ? "true" : "false")"
                tabindex="@(activeSection == "storage" ? "0" : "-1")"
                aria-controls="settings-storage-panel">Storage</button>
      }
    </nav>
    <div class="settings-section-panels">
  <div id="settings-repository-panel" role="tabpanel" aria-labelledby="settings-tab-repository"
       hidden="@(activeSection != "repository")">
  <section class="operations-card configuration-card">
    <header>
      <div>
        <h3>Repository settings</h3>
        <span>Scope: repository · shared with everyone on the project · typed, revision-checked updates</span>
        @if (Model.Configuration is not null)
        {
          <span title="@Model.Configuration.SourcePath">Source: @Model.Configuration.SourcePath</span>
        }
      </div>
      @if (Model.Configuration is not null)
      {
        <code>schema @Model.Configuration.SchemaVersion · stored @Model.Configuration.Revision[..10] · active @(Model.ActiveConfigurationRevision is null ? "unknown" : Model.ActiveConfigurationRevision[..10])</code>
      }
    </header>
    @if (Model.Configuration is { } configuration)
    {
      var current = configuration.StoredConfiguration;
      var draft = Model.ConfigurationDraft;
      var workflowDraft = draft?.Operation == "workflow";
      var workerDraft = draft?.Operation == "worker";
      var usageFailureDraft = draft?.Operation == "usage-failure";
      var completionDraft = draft?.Operation == "completion";
      var archiveDraft = draft?.Operation == "archive";
      var webDraft = draft?.Operation == "web";
      var profilesDraft = draft?.Operation == "profiles";
      var webDrift = Model.ActiveConfigurationRevision is not null &&
        !string.Equals(Model.ActiveConfigurationRevision, configuration.Revision, StringComparison.Ordinal);
      var workerDrift = Model.Workers.Count(worker =>
        !string.Equals(worker.Instance.ConfigurationRevision, configuration.Revision, StringComparison.Ordinal));
      var workerProcessNoun = Grammar.Plural(workerDrift, "process");
      var usageFailure = current.EffectiveWorker.EffectiveUsageFailure;
      var executionProfilesValue = profilesDraft
        ? draft?.ExecutionProfiles ?? string.Empty
        : string.Join(", ", current.EffectiveWorker.EffectiveExecutionProfiles);
      var displayedExecutionProfiles = executionProfilesValue
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(profile => profile.ToLowerInvariant())
        .Distinct(StringComparer.Ordinal)
        .ToArray();
      var displayedDefaultExecutionProfile = profilesDraft
        ? draft?.DefaultExecutionProfile
        : current.EffectiveWorker.DefaultExecutionProfile;
      var knownExecutionProfiles = Highbyte.Wrighty.Workers.BuiltInExecutionProfiles.Names
        .Concat(current.EffectiveWorker.EffectiveExecutionProfiles)
        .Concat(Model.UserConfiguration?.Stored.WorkerProfiles.Keys ?? [])
        .Concat(displayedExecutionProfiles)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(profile => profile, StringComparer.OrdinalIgnoreCase)
        .ToArray();
      var archiveStatusesValue = archiveDraft
        ? draft?.ArchiveStatuses ?? string.Empty
        : string.Join(", ", current.Archive.OnStatuses);
      var knownArchiveStatuses = (current.LocalMarkdown?.Statuses ?? [])
        .Concat([current.DefaultPickFrom, current.DefaultPickTo, current.DefaultFinishTo])
        .Concat(current.Archive.OnStatuses)
        .Concat(archiveStatusesValue.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        .Where(status => !string.IsNullOrWhiteSpace(status))
        .Where(status => WorkflowStatusPolicy.ArchiveRestriction(
          current,
          current.LocalMarkdown?.Statuses ?? [],
          status) is null)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToArray();
      @if (webDrift || workerDrift > 0)
      {
        <output id="configuration-restart-warning" class="warning">
          Saved configuration differs from
          @(webDrift ? "this web process" : string.Empty)@((webDrift && workerDrift > 0) ? " and " : string.Empty)@(workerDrift > 0 ? $"{workerDrift} local worker {workerProcessNoun}" : string.Empty).
          Restart the affected processes before relying on changes that are not applied dynamically.
          Agent simulations are read on demand and do not require a restart.
        </output>
      }
      else if (Model.ActiveConfigurationRevision is null)
      {
        <output id="configuration-restart-warning" class="warning">
          Running workers are not reconfigured automatically. Restart any worker using this configuration after a save.
        </output>
      }
      @if (configuration.RequiresCanonicalizationApproval)
      {
        <div class="warning" role="note">This file contains comments or trailing commas. Saving rewrites it as canonical JSON and requires explicit approval below.</div>
      }
      @if (configuration.LegacyProperties is { Count: > 0 } legacyProperties)
      {
        <div class="warning" role="note">This file contains values written by an earlier Wrighty version: @string.Join(", ", legacyProperties). They are not settings and are ignored. Saving any section below removes them, whether or not you change a value.</div>
      }
      <div class="configuration-forms">
        <form id="configuration-workflow-form" method="post" data-settings-dirty="@(workflowDraft ? "true" : null)" hx-post="/?handler=Configuration" hx-target="#settings-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="workflow">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Workflow defaults</h4>
          <label>Pick from <input id="configuration-default-pick-from" name="defaultPickFrom" value="@(workflowDraft ? draft!.DefaultPickFrom : current.DefaultPickFrom)" required></label>
          <label>Pick to <input id="configuration-default-pick-to" name="defaultPickTo" value="@(workflowDraft ? draft!.DefaultPickTo : current.DefaultPickTo)" required></label>
          <label>Finish to <input id="configuration-default-finish-to" name="defaultFinishTo" value="@(workflowDraft ? draft!.DefaultFinishTo : current.DefaultFinishTo)" required></label>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(workflowDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit" data-settings-save disabled="@(!workflowDraft)">Save workflow</button>
        </form>

        <form id="configuration-worker-form" method="post" data-settings-dirty="@(workerDraft ? "true" : null)" hx-post="/?handler=Configuration" hx-target="#settings-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="worker">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Worker defaults</h4>
          <label>Default agent
            <select id="configuration-default-agent" name="defaultAgent">
              <option value="" selected="@((workerDraft ? draft!.DefaultAgent : current.EffectiveWorker.DefaultAgent) is null or "")">Item or invocation policy</option>
              @foreach (var agent in new[] { "claude", "codex", "copilot" })
              {
                <option value="@agent" selected="@(agent == (workerDraft ? draft!.DefaultAgent : current.EffectiveWorker.DefaultAgent))">@agent</option>
              }
            </select>
          </label>
          <label>Workspace mode
            <select id="configuration-workspace-mode" name="workspaceMode">
              @foreach (var mode in new[] { "current", "shared", "worktree" })
              {
                <option value="@mode" selected="@(mode == (workerDraft ? draft!.WorkspaceMode : current.EffectiveWorker.WorkspaceMode ?? "current"))">@mode</option>
              }
            </select>
          </label>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(workerDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit" data-settings-save disabled="@(!workerDraft)">Save worker defaults</button>
        </form>

        <form id="configuration-profiles-form" class="configuration-form-wide" method="post"
              data-settings-dirty="@(profilesDraft ? "true" : null)"
              hx-post="/?handler=Configuration" hx-target="#settings-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="profiles">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Agent execution profiles</h4>
          <div class="token-picker-setting">
            <label for="configuration-execution-profiles">Profile names this repository recognizes</label>
            <div data-token-picker data-token-label="profile"
                 data-allow-create="true"
                 data-dependent-select="configuration-default-execution-profile"
                 data-known-values="@JsonSerializer.Serialize(knownExecutionProfiles)">
              <input id="configuration-execution-profiles" name="executionProfiles"
                     data-token-source value="@executionProfilesValue"
                     placeholder="economy, balanced, deep" autocomplete="off">
            </div>
          </div>
          <label>Applied when neither the run nor the item names one
            <select id="configuration-default-execution-profile" name="defaultExecutionProfile"
                    data-empty-label="None">
              <option value="" selected="@(string.IsNullOrWhiteSpace(displayedDefaultExecutionProfile))">None</option>
              @foreach (var profile in displayedExecutionProfiles)
              {
                <option value="@profile" selected="@(string.Equals(profile, displayedDefaultExecutionProfile, StringComparison.OrdinalIgnoreCase))">@profile</option>
              }
            </select>
          </label>
          <p class="muted configuration-help">
            Shared policy: these names are committed and everyone on the project sees them. What each
            one resolves to in vendor terms is decided in your user settings, below.
          </p>
          @if (Model.Backend == "github")
          {
            <p class="muted configuration-help">
              <strong>Removing a name is not only a file edit.</strong> The next <code>wrighty init</code>
              deletes the matching board option, which clears the profile from every item still holding
              it. Those items fall back to the repository default on their next run.
            </p>
          }
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(profilesDraft && draft?.ApproveCanonicalization == true)">Approve JSON normalization</label>
          }
          <button type="submit" data-settings-save disabled="@(!profilesDraft)">Save agent execution profiles</button>
        </form>

        <form id="configuration-usage-failure-form" class="usage-recovery-form" method="post"
              data-settings-dirty="@(usageFailureDraft ? "true" : null)"
              hx-post="/?handler=Configuration" hx-target="#settings-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="usage-failure">
          <input type="hidden" id="configuration-usage-failure-revision" name="revision" value="@configuration.Revision">
          <h4>Agent usage recovery</h4>
          <p class="muted configuration-help">
            Controls what workers do when an agent reports exhausted usage or rate limiting.
            Authentication, permission, and billing failures still require operator attention.
          </p>
          <div class="usage-recovery-fields">
            <label>First response
              <select id="configuration-usage-failure-action" name="usageFailureAction">
                @foreach (var option in new[]
                {
                  (Value: "retry", Label: "Retry the same agent"),
                  (Value: "handoff", Label: "Hand off immediately"),
                  (Value: "needs-attention", Label: "Stop for operator attention")
                })
                {
                  <option value="@option.Value"
                          selected="@(option.Value == (usageFailureDraft ? draft!.UsageFailureAction : usageFailure.Action))">@option.Label</option>
                }
              </select>
            </label>
            <label>Initial retry delay (minutes)
              <input id="configuration-usage-failure-initial-retry-minutes"
                     name="usageFailureInitialRetryMinutes" type="number" min="0.000001" step="any" required
                     value="@(usageFailureDraft ? draft!.UsageFailureInitialRetryMinutes : usageFailure.InitialRetryMinutes.ToString(CultureInfo.InvariantCulture))">
            </label>
            <label>Retry backoff multiplier
              <input id="configuration-usage-failure-backoff-multiplier"
                     name="usageFailureBackoffMultiplier" type="number" min="1" step="any" required
                     value="@(usageFailureDraft ? draft!.UsageFailureBackoffMultiplier : usageFailure.BackoffMultiplier.ToString(CultureInfo.InvariantCulture))">
            </label>
            <label>Maximum retry delay (hours)
              <input id="configuration-usage-failure-max-retry-hours"
                     name="usageFailureMaxRetryHours" type="number" min="0.000001" step="any" required
                     value="@(usageFailureDraft ? draft!.UsageFailureMaxRetryHours : usageFailure.MaxRetryHours.ToString(CultureInfo.InvariantCulture))">
            </label>
            <label>Maximum retry attempts
              <input id="configuration-usage-failure-max-attempts"
                     name="usageFailureMaxAttempts" type="number" min="1" step="1" required
                     value="@(usageFailureDraft ? draft!.UsageFailureMaxAttempts : usageFailure.MaxAttempts.ToString(CultureInfo.InvariantCulture))">
            </label>
            <label>Reset grace period (minutes)
              <input id="configuration-usage-failure-reset-grace-minutes"
                     name="usageFailureResetGraceMinutes" type="number" min="0" step="any" required
                     value="@(usageFailureDraft ? draft!.UsageFailureResetGraceMinutes : usageFailure.ResetGraceMinutes.ToString(CultureInfo.InvariantCulture))">
            </label>
            <label>After retries are exhausted
              <select id="configuration-usage-failure-allow-cross-agent-handoff"
                      name="usageFailureAllowCrossAgentHandoff">
                <option value="false" selected="@(usageFailureDraft ? !draft!.UsageFailureAllowCrossAgentHandoff : !usageFailure.AllowCrossAgentHandoff)">Stop for operator attention</option>
                <option value="true" selected="@(usageFailureDraft ? draft!.UsageFailureAllowCrossAgentHandoff : usageFailure.AllowCrossAgentHandoff)">Hand off to another agent</option>
              </select>
            </label>
          </div>
          <fieldset class="usage-recovery-fallbacks">
            <legend>Agent fallback order</legend>
            <div class="token-picker-setting">
              <label for="configuration-usage-failure-claude-fallbacks">After Claude</label>
              <div data-token-picker data-token-label="fallback agent" data-ordered="true"
                   data-known-values="@JsonSerializer.Serialize(new[] { "codex", "copilot" })">
                <input id="configuration-usage-failure-claude-fallbacks" name="usageFailureClaudeFallbacks"
                       data-token-source
                       value="@(usageFailureDraft ? draft!.UsageFailureClaudeFallbacks : string.Join(", ", usageFailure.Fallbacks.GetValueOrDefault("claude", [])))"
                       placeholder="codex, copilot" autocomplete="off">
              </div>
            </div>
            <div class="token-picker-setting">
              <label for="configuration-usage-failure-codex-fallbacks">After Codex</label>
              <div data-token-picker data-token-label="fallback agent" data-ordered="true"
                   data-known-values="@JsonSerializer.Serialize(new[] { "claude", "copilot" })">
                <input id="configuration-usage-failure-codex-fallbacks" name="usageFailureCodexFallbacks"
                       data-token-source
                       value="@(usageFailureDraft ? draft!.UsageFailureCodexFallbacks : string.Join(", ", usageFailure.Fallbacks.GetValueOrDefault("codex", [])))"
                       placeholder="claude, copilot" autocomplete="off">
              </div>
            </div>
            <div class="token-picker-setting">
              <label for="configuration-usage-failure-copilot-fallbacks">After Copilot</label>
              <div data-token-picker data-token-label="fallback agent" data-ordered="true"
                   data-known-values="@JsonSerializer.Serialize(new[] { "claude", "codex" })">
                <input id="configuration-usage-failure-copilot-fallbacks" name="usageFailureCopilotFallbacks"
                       data-token-source
                       value="@(usageFailureDraft ? draft!.UsageFailureCopilotFallbacks : string.Join(", ", usageFailure.Fallbacks.GetValueOrDefault("copilot", [])))"
                       placeholder="codex, claude" autocomplete="off">
              </div>
            </div>
          </fieldset>
          <p class="muted configuration-help">
            The order is used immediately when <strong>First response</strong> is handoff, or after
            retries when cross-agent handoff is enabled. An order by itself does not enable handoff.
          </p>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(usageFailureDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button id="configuration-usage-failure-save" type="submit" data-settings-save
                  disabled="@(!usageFailureDraft)">Save agent usage recovery</button>
        </form>

        <form id="configuration-completion-form" method="post" data-settings-dirty="@(completionDraft ? "true" : null)" hx-post="/?handler=Configuration" hx-target="#settings-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="completion">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Completion policy</h4>
          <label>Commit
            <select id="configuration-completion-commit" name="completionCommit">
              @foreach (var value in new[] { "inspect", "agent" })
              {
                <option value="@value" selected="@(value == (completionDraft ? draft!.CompletionCommit : current.EffectiveWorker.Completion?.Commit ?? "inspect"))">@value</option>
              }
            </select>
          </label>
          <label>Integration
            <select id="configuration-completion-integration" name="completionIntegration">
              @foreach (var value in new[] { "none", "merge-local", "push-pr" })
              {
                <option value="@value" selected="@(value == (completionDraft ? draft!.CompletionIntegration : current.EffectiveWorker.Completion?.Integration ?? "none"))">@value</option>
              }
            </select>
          </label>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(completionDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit" data-settings-save disabled="@(!completionDraft)">Save completion</button>
        </form>

        <form id="configuration-archive-form" method="post" data-settings-dirty="@(archiveDraft ? "true" : null)" hx-post="/?handler=Configuration" hx-target="#settings-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="archive">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Archive policy</h4>
          <div class="token-picker-setting">
            <label for="configuration-archive-statuses">Archive on statuses</label>
            <div data-token-picker data-token-label="archive status"
                 data-preserve-case="true"
                 data-allow-create="@(current.LocalMarkdown is null ? "true" : "false")"
                 data-create-mode="value"
                 data-known-values="@JsonSerializer.Serialize(knownArchiveStatuses)">
              <input id="configuration-archive-statuses" name="archiveStatuses"
                     data-token-source value="@archiveStatusesValue"
                     placeholder="Done, Cancelled" autocomplete="off">
            </div>
          </div>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(archiveDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit" data-settings-save disabled="@(!archiveDraft)">Save archive policy</button>
        </form>

        <form id="configuration-web-form" method="post" data-settings-dirty="@(webDraft ? "true" : null)" hx-post="/?handler=Configuration" hx-target="#settings-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="web">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Web policy</h4>
          <label>Protect non-human claims
            <select id="configuration-protect-non-human-claims" name="protectNonHumanClaims">
              <option value="true" selected="@(webDraft ? draft!.ProtectNonHumanClaims : current.EffectiveWeb.ProtectNonHumanClaims)">true</option>
              <option value="false" selected="@(webDraft ? !draft!.ProtectNonHumanClaims : !current.EffectiveWeb.ProtectNonHumanClaims)">false</option>
            </select>
          </label>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(webDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit" data-settings-save disabled="@(!webDraft)">Save web policy</button>
        </form>
      </div>

      var testing = current.EffectiveTesting;
      var activeTestingAgents = Model.AgentRuntimes.Count(runtime =>
        testing.PretendsAgentIsNotInstalled(runtime.Agent) ||
        testing.FindAgentFailure(runtime.Agent) is not null);
      <details class="advanced-testing" open="@(activeTestingAgents > 0 || draft?.Operation is "testing" or "testing-reset")">
        <summary>
          <span>Advanced/testing</span>
          @if (activeTestingAgents > 0)
          {
            <strong>@activeTestingAgents active</strong>
          }
        </summary>
        <div class="advanced-testing-content">
          <div>
            <h4>Agent simulation</h4>
            <p class="muted">
              Deliberately change how this repository sees an agent or replace its implementation
              result to exercise launch, retry, handoff, and operator-attention behavior.
            </p>
            <p class="warning">
              These settings are stored in <code>.wrighty.json</code> and affect every Wrighty host
              using this repository until they are turned off. Availability simulation affects
              installation-dependent UI, checks, probes, and launches. Synthetic implementation
              results leave checks, probes, and requirements-readiness turns real.
            </p>
          </div>
          @if (activeTestingAgents > 0)
          {
            <form class="testing-reset-form" method="post" hx-post="/?handler=Configuration"
                  hx-target="#settings-content" hx-swap="outerHTML">
              @Html.AntiForgeryToken()
              <input type="hidden" name="operation" value="testing-reset">
              <input type="hidden" name="revision" value="@configuration.Revision">
              @if (configuration.RequiresCanonicalizationApproval)
              {
                <label class="checkbox-field">
                  <input type="checkbox" name="approveCanonicalization" value="true">
                  Approve JSON normalization
                </label>
              }
              <button type="submit">Turn off all simulations</button>
            </form>
          }
          <div class="failure-simulation-list">
            @foreach (var runtime in Model.AgentRuntimes)
            {
              var agent = runtime.Agent;
              var rowDraft = draft?.Operation == "testing" && string.Equals(
                draft.Agent, agent, StringComparison.OrdinalIgnoreCase);
              var pretendNotInstalled = rowDraft
                ? draft!.PretendNotInstalled
                : testing.PretendsAgentIsNotInstalled(agent);
              var simulation = testing.FindAgentFailure(agent);
              var selectedToken = rowDraft
                ? draft!.FailureKind
                : simulation is null
                  ? null
                  : Highbyte.Wrighty.Workers.AgentFailureSimulationKinds.Find(simulation.Kind)?.Token;
              var selectedOption = Highbyte.Wrighty.Workers.AgentFailureSimulationKinds.All
                .FirstOrDefault(option => string.Equals(
                  option.Token, selectedToken, StringComparison.OrdinalIgnoreCase));
              var retryAfter = rowDraft
                ? draft!.RetryAfterSeconds ?? 0
                : selectedOption?.UsesRetryDelay == true ? simulation?.RetryAfterSeconds ?? 0 : 0;
              var fallbackAgents = usageFailure.Fallbacks.TryGetValue(agent, out var configuredFallbacks)
                ? configuredFallbacks
                : [];
              var fallbackOrder = fallbackAgents.Count == 0
                ? "no configured fallbacks"
                : string.Join(" → ", fallbackAgents);
              var recoveryDescription = usageFailure.Action.ToLowerInvariant() switch
              {
                "handoff" => $"hand off immediately ({fallbackOrder})",
                "needs-attention" => "stop immediately for operator attention",
                _ when usageFailure.AllowCrossAgentHandoff =>
                  $"retry this agent up to {usageFailure.MaxAttempts} times, then hand off ({fallbackOrder})",
                _ => $"retry this agent up to {usageFailure.MaxAttempts} times; cross-agent handoff is off"
              };
              <form id="agent-testing-@agent" class="failure-simulation-row" method="post"
                    data-settings-dirty="@(rowDraft ? "true" : null)"
                    hx-post="/?handler=Configuration"
                    hx-target="#settings-content" hx-swap="outerHTML">
                @Html.AntiForgeryToken()
                <input type="hidden" name="operation" value="testing">
                <input type="hidden" id="agent-testing-revision-@agent"
                       name="revision" value="@configuration.Revision">
                <input type="hidden" name="agent" value="@agent">
                <span class="agent-testing-identity">
                  <strong>@agent</strong>
                  <small>@(runtime.InstallationSimulated
                    ? "Pretending not installed"
                    : runtime.Installed ? "Installed locally" : "Not detected locally")</small>
                </span>
                <label>
                  <span>Availability</span>
                  <select name="pretendNotInstalled" aria-label="Availability simulation for @agent">
                    <option value="false" selected="@(!pretendNotInstalled)">Use actual detection</option>
                    <option value="true" selected="@pretendNotInstalled">Pretend not installed</option>
                  </select>
                </label>
                <label>
                  <span>Implementation result</span>
                  <select name="failureKind" aria-label="Implementation result for @agent"
                          disabled="@pretendNotInstalled">
                    <option value="" selected="@(selectedToken is null or "")">Use real result</option>
                    <optgroup label="Uses retry / handoff policy">
                      @foreach (var option in Highbyte.Wrighty.Workers.AgentFailureSimulationKinds.All
                        .Where(option => option.UsesRetryDelay))
                      {
                        <option value="@option.Token"
                                selected="@(string.Equals(selectedToken, option.Token, StringComparison.OrdinalIgnoreCase))"
                                title="@option.Behaviour">@option.Label</option>
                      }
                    </optgroup>
                    <optgroup label="Other failure handling">
                      @foreach (var option in Highbyte.Wrighty.Workers.AgentFailureSimulationKinds.All
                        .Where(option => !option.UsesRetryDelay))
                      {
                        <option value="@option.Token"
                                selected="@(string.Equals(selectedToken, option.Token, StringComparison.OrdinalIgnoreCase))"
                                title="@option.Behaviour">@option.Label</option>
                      }
                    </optgroup>
                  </select>
                  @if (pretendNotInstalled)
                  {
                    <input type="hidden" name="failureKind" value="@selectedToken">
                  }
                </label>
                <label>
                  <span>Retry after (seconds)</span>
                  <input type="number" name="retryAfterSeconds" min="0" max="86400" step="1"
                         value="@retryAfter" disabled="@pretendNotInstalled"
                         aria-describedby="agent-testing-retry-help-@agent">
                  @if (pretendNotInstalled)
                  {
                    <input type="hidden" name="retryAfterSeconds" value="@retryAfter">
                  }
                </label>
                <button type="submit" data-settings-save disabled="@(!rowDraft)">Save<span class="visually-hidden"> @agent simulation</span></button>
                <small id="agent-testing-retry-help-@agent" class="agent-testing-help">
                  Usage exhausted and rate limited use the repository recovery policy: @recoveryDescription.
                  Authentication, billing, and permission failures stop for operator attention;
                  the remaining choices use ordinary failure handling. An availability override
                  prevents launch, so its implementation-result controls are retained but disabled.
                </small>
                @if (configuration.RequiresCanonicalizationApproval)
                {
                  <label class="checkbox-field failure-simulation-approval">
                    <input type="checkbox" name="approveCanonicalization" value="true">
                    Approve JSON normalization
                  </label>
                }
              </form>
            }
          </div>
        </div>
      </details>

      <details class="settings-catalog">
        <summary>Repository settings catalogue (@configuration.Settings.Count settings)</summary>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Setting</th><th>Effective value</th><th>Source</th><th>Applies at</th><th>Edit mode</th></tr></thead>
            <tbody>
            @foreach (var setting in configuration.Settings)
            {
              <tr>
                <td><code>@setting.Id</code><small>@setting.Help</small></td>
                <td><code>@JsonSerializer.Serialize(setting.EffectiveValue)</code></td>
                <td>@setting.DefaultSource</td>
                <td>@setting.EffectiveBoundary</td>
                <td>@setting.EditMode</td>
              </tr>
            }
            </tbody>
          </table>
        </div>
      </details>
    }
    else
    {
      <p class="empty-state">The repository configuration could not be loaded, so its settings cannot be edited here.</p>
    }
  </section>
  </div>

  @if (Model.UserConfiguration is { } user)
  {
    <div id="settings-user-panel" role="tabpanel" aria-labelledby="settings-tab-user"
         hidden="@(activeSection != "user")">
    <section class="operations-card user-configuration">
      <div class="user-configuration-summary">
        <div class="user-configuration-intro">
          <h3>User settings</h3>
          <p class="muted">
            Settings that belong to you, not to the project. They are stored in your user profile
            on this computer, never written to <code>.wrighty.json</code>, and never travel to
            anyone else.
          </p>
          <p class="muted user-configuration-source">
            <span>Source:</span>
            <code>@user.SourcePath</code>@(user.Exists ? "" : " (not created yet)")
          </p>
          @if (user.AwaitingMigration)
          {
            <p class="muted">Reading the previous settings version; the next save rewrites it.</p>
          }
        </div>

        <form id="user-configuration-host-form" method="post"
              hx-post="/?handler=UserConfiguration"
              hx-target="#settings-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="hostLabel">
          <input type="hidden" id="user-configuration-revision" name="revision" value="@user.Revision">
          <h4>Host label</h4>
          <label for="user-configuration-host-label">Shown when this computer hands work over</label>
          <div class="user-host-label-controls">
            <input id="user-configuration-host-label" name="hostLabel"
                   aria-describedby="user-configuration-host-help"
                   value="@(user.Stored.HostLabel ?? string.Empty)"
                   placeholder="@Highbyte.Wrighty.Settings.HostLabelProvider.AnonymousLabel">
            <button type="submit" data-settings-save disabled>Save<span class="visually-hidden"> host label</span></button>
          </div>
          <p id="user-configuration-host-help" class="muted">Leave empty to hand over as
            <code>@Highbyte.Wrighty.Settings.HostLabelProvider.AnonymousLabel</code>.</p>
        </form>
      </div>

      @{
        // The repository vocabulary when it loaded; the built-in names otherwise, so this
        // user's mappings stay editable even while the repository file cannot be read.
        var vocabulary =
          Model.Configuration?.StoredConfiguration.EffectiveWorker.EffectiveExecutionProfiles
            is { Count: > 0 } sharedProfiles
              ? sharedProfiles
              : Highbyte.Wrighty.Workers.BuiltInExecutionProfiles.Names;
      }
      <p class="muted">
        What a profile means for you on this computer. One row per mapping — edit it in place, or
        add one below. A profile with no row here resolves to its built-in tier.
      </p>
      <div class="mapping-list">
        <div class="mapping-list-head"><span>Profile</span><span>Agent</span><span>Model</span><span>Effort</span><span></span></div>
        @foreach (var profileEntry in user.Stored.WorkerProfiles.OrderBy(entry => entry.Key, StringComparer.OrdinalIgnoreCase))
        {
          @foreach (var agentEntry in profileEntry.Value.OrderBy(entry => entry.Key, StringComparer.OrdinalIgnoreCase))
          {
            var rowCatalog = Model.AgentModels.FirstOrDefault(candidate =>
              string.Equals(candidate.Agent, agentEntry.Key, StringComparison.OrdinalIgnoreCase));
            <form class="mapping-row" method="post" hx-post="/?handler=ProfileMapping"
                  hx-target="#settings-content" hx-swap="outerHTML">
              @Html.AntiForgeryToken()
              <input type="hidden" name="revision" value="@user.Revision">
              <input type="hidden" name="profile" value="@profileEntry.Key">
              <input type="hidden" name="agent" value="@agentEntry.Key">
              <span>@profileEntry.Key</span>
              <span>@agentEntry.Key</span>
              <partial name="Shared/_MappingModelControl"
                       model="new MappingModelControl(rowCatalog, agentEntry.Value.Model)" />
              <label>
                <span class="visually-hidden">Effort for @profileEntry.Key on @agentEntry.Key</span>
                <select name="effort">
                  <option value="">vendor default</option>
                  @foreach (var level in Highbyte.Wrighty.Workers.ExecutionEfforts.All)
                  {
                    <option value="@level" selected="@(agentEntry.Value.Effort?.ToToken() == level)">@level</option>
                  }
                </select>
              </label>
              <span class="mapping-actions">
                @* Disabled until the row differs from what is stored, so a touched row is
                   visibly different from an untouched one. Enabled from app.js; without
                   scripts the button works but is never disabled. *@
                <button type="submit" disabled>Update</button>
                <button type="submit" name="remove" value="true">Remove</button>
              </span>
            </form>
          }
        }
        <form id="mapping-add-form" class="mapping-row" method="post" hx-post="/?handler=ProfileMapping"
              hx-target="#settings-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="revision" value="@user.Revision">
          <label>
            <span class="visually-hidden">Profile to map</span>
            <select name="profile">
              @foreach (var name in vocabulary)
              {
                <option value="@name">@name</option>
              }
            </select>
          </label>
          <label>
            <span class="visually-hidden">Agent to map</span>
            <select name="agent"
                    hx-get="/?handler=MappingModelChoices" hx-target="#mapping-add-model" hx-swap="innerHTML">
              @foreach (var agentName in Model.AgentModels.Select(catalog => catalog.Agent))
              {
                <option value="@agentName">@agentName</option>
              }
            </select>
          </label>
          <span id="mapping-add-model">
            <partial name="Shared/_MappingModelControl"
                     model="new MappingModelControl(Model.AgentModels.FirstOrDefault(), null)" />
          </span>
          <label>
            <span class="visually-hidden">Effort for the new mapping</span>
            <select name="effort">
              <option value="">vendor default</option>
              @foreach (var level in Highbyte.Wrighty.Workers.ExecutionEfforts.All)
              {
                <option value="@level">@level</option>
              }
            </select>
          </label>
          <span class="mapping-actions"><button type="submit" disabled>Add</button></span>
        </form>
      </div>

      <details class="settings-catalog">
        <summary>User settings catalogue (@user.Settings.Count settings)</summary>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Setting</th><th>Effective value</th><th>Source</th><th>Applies at</th><th>Edit mode</th></tr></thead>
            <tbody>
            @foreach (var setting in user.Settings)
            {
              <tr>
                <td><code>@setting.Id</code><small>@setting.Help</small></td>
                <td><code>@JsonSerializer.Serialize(setting.EffectiveValue)</code></td>
                <td>@setting.DefaultSource</td>
                <td>@setting.EffectiveBoundary</td>
                <td>@setting.EditMode</td>
              </tr>
            }
            </tbody>
          </table>
        </div>
      </details>
    </section>
    </div>
  }

  @if (Model.StorageLocations.Count > 0)
  {
    <div id="settings-storage-panel" role="tabpanel" aria-labelledby="settings-tab-storage"
         hidden="@(activeSection != "storage")">
    <section id="storage-locations" class="operations-card storage-locations">
      <h3>Storage locations</h3>
      <p class="muted">
        Effective local paths used by this installation and tracker. Lifecycle labels distinguish
        shared content, machine-local state, disposable cache, and credentials. Credential values
        are never displayed.
      </p>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Location</th><th>Path</th><th>Lifecycle</th><th>Backend</th><th>Status</th></tr></thead>
          <tbody>
          @foreach (var location in Model.StorageLocations)
          {
            var status = location.Exists switch
            {
              true => "Present",
              false => "Not present",
              null => "Pattern"
            };
            <tr id="storage-location-@location.Id.Replace('.', '-')">
              <td><strong>@location.Name</strong><small>@location.Description</small></td>
              <td><code>@location.Path</code></td>
              <td>@location.LifecycleLabel</td>
              <td>@location.AppliesTo</td>
              <td>@status</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    </section>
    </div>
  }
    </div>
  </div>
</section>
