@model BoardPageModel
@{
  // Feeds the needs-attention badge on the Board tab. Absent for the archived scope, whose
  // response has no active columns to count — the badge then keeps its last known value.
  var attention = Model.Columns
    .SelectMany(column => column.Cards)
    .Where(card => card.OperationalStatus == OperationalStatuses.NeedsAttention)
    .ToArray();
}
<section id="board-content" class="board-region" data-revision="@Model.Revision"
         data-batch-search="@Model.EffectiveQuery.Search"
         data-structured-filter-count="@(Model.EffectiveQuery.HasStructuredFilters ? Model.Columns.Sum(column => column.Cards.Count) + Model.Archived.Count : null)"
         data-attention-count="@(Model.Scope == "archived" ? null : attention.Length.ToString())"
         hx-get="/?handler=Board" hx-trigger="wrighty:refresh" hx-include="#board-filters" hx-swap="outerHTML">
  @if (Model.ErrorCode is not null)
  {
    <div class="error" role="alert"><strong>@Model.ErrorCode</strong> @Model.ErrorMessage</div>
  }
  else
  {
    <div id="board-batch-result" class="board-batch-result-region" aria-live="polite">
      @if (Model.BatchResult is { HasIssues: true })
      {
        <partial name="Shared/_BoardBatchResult" model="Model.BatchResult" />
      }
    </div>
    @if (Model.EffectiveQuery.HasStructuredFilters)
    {
      <div class="active-filter-chips" aria-label="Active board filters">
        @foreach (var value in Model.EffectiveQuery.ClaimKinds){<button type="button" data-clear-board-filter="claimKind" data-clear-board-value="@value">Claimant: @value <span aria-hidden="true">×</span></button>}
        @foreach (var value in Model.EffectiveQuery.Agents){<button type="button" data-clear-board-filter="agent" data-clear-board-value="@value">Agent: @value <span aria-hidden="true">×</span></button>}
        @foreach (var value in Model.EffectiveQuery.Priorities){<button type="button" data-clear-board-filter="priority" data-clear-board-value="@value">Priority: @value <span aria-hidden="true">×</span></button>}
        @foreach (var value in Model.EffectiveQuery.ClaimStates){<button type="button" data-clear-board-filter="claimState" data-clear-board-value="@value">Claim: @value <span aria-hidden="true">×</span></button>}
        @if (Model.EffectiveQuery.UpdatedWithin is { } updated){<button type="button" data-clear-board-filter="updatedWithin">Updated: @updated <span aria-hidden="true">×</span></button>}
        <button type="button" data-clear-board-filters>Clear all</button>
      </div>
    }
    @if (Model.Scope == "archived")
    {
      <partial name="Shared/_Archived" model="Model.Archived" />
    }
    else
    {
    @if (attention.Length > 0)
    {
      <aside class="attention-summary" aria-labelledby="attention-summary-title">
        <h2 id="attention-summary-title">Attention required <span>@attention.Length</span></h2>
        <div class="attention-links">
          @foreach (var card in attention)
          {
            <button type="button" hx-get="/?handler=Item&amp;id=@Uri.EscapeDataString(card.Id)"
                    hx-target="#item-panel" hx-swap="innerHTML">
              <span class="display-id">@card.DisplayId</span>
              <span>@card.Title</span>
              <span>@(card.AgentLabel ?? "Agent") paused</span>
            </button>
          }
        </div>
      </aside>
    }
    <form id="board-drag-token" hidden>@Html.AntiForgeryToken()</form>
    <div class="board" aria-label="Work items by status">
      @foreach (var column in Model.Columns)
      {
        var countDescription = $"{column.Cards.Count} item{(column.Cards.Count == 1 ? "" : "s")} currently shown in this column.";
        var bulkAction = column.BulkAction;
        <section class="column" data-drop-status="@column.Name" data-board-column-index="@column.Index"
                 aria-labelledby="column-@column.Name.GetHashCode()">
          <header>
            <div class="column-title-row">
              <h2 id="column-@column.Name.GetHashCode()" tabindex="-1">@column.Name</h2>
              @if (bulkAction is not null)
              {
                <form id="board-bulk-@bulkAction.Id-column-@column.Index"
                      class="column-bulk-action"
                      hx-post="/?handler=ExecuteBoardBatch"
                      hx-target="#board-batch-result" hx-swap="innerHTML"
                      hx-disabled-elt="find button"
                      data-board-bulk-action="@bulkAction.Id"
                      data-confirm-title="@bulkAction.ConfirmTitle"
                      data-confirm-message="@bulkAction.ConfirmMessage"
                      data-confirm-action="@bulkAction.ConfirmAction">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="intentId" value="@bulkAction.IntentId">
                  <button type="submit" title="@bulkAction.Description">@bulkAction.Label</button>
                </form>
              }
              <span class="column-count has-tooltip"
                    data-visible-count
                    data-total-count="@column.Cards.Count"
                    data-tooltip="@countDescription"
                    aria-label="@countDescription"
                    tabindex="0">@column.Cards.Count</span>
            </div>
            @if (bulkAction is not null && bulkAction.EligibleCount != bulkAction.ShownCount)
            {
              <p class="column-bulk-eligibility" role="note">@bulkAction.Description</p>
            }
            <label class="column-sort-label">
              <span class="visually-hidden">Sort @column.Name</span>
              <span class="sort-control">
                <select id="column-sort-@column.Index" class="column-sort" name="columnSort" form="board-filters" data-sort-select
                        data-board-column-sort-index="@column.Index"
                        aria-label="Sort @column.Name column">
                  <option value="" selected="@(Model.EffectiveQuery.ColumnSorts.ContainsKey(column.Index) ? null : "selected")">Board sort</option>
                  <option value="@column.Index:updated:desc" selected="@(Model.EffectiveQuery.ColumnSorts.TryGetValue(column.Index, out var updatedSort) && updatedSort == new ItemSort(ItemSortField.Updated, true) ? "selected" : null)">Recently updated</option>
                  <option value="@column.Index:updated:asc" selected="@(Model.EffectiveQuery.ColumnSorts.TryGetValue(column.Index, out var updatedAscSort) && updatedAscSort == new ItemSort(ItemSortField.Updated, false) ? "selected" : null)">Least recently updated</option>
                  <option value="@column.Index:created:desc" selected="@(Model.EffectiveQuery.ColumnSorts.TryGetValue(column.Index, out var createdSort) && createdSort == new ItemSort(ItemSortField.Created, true) ? "selected" : null)">Newest created</option>
                  <option value="@column.Index:created:asc" selected="@(Model.EffectiveQuery.ColumnSorts.TryGetValue(column.Index, out var createdAscSort) && createdAscSort == new ItemSort(ItemSortField.Created, false) ? "selected" : null)">Oldest created</option>
                  <option value="@column.Index:priority:asc" selected="@(Model.EffectiveQuery.ColumnSorts.TryGetValue(column.Index, out var prioritySort) && prioritySort == new ItemSort(ItemSortField.Priority, false) ? "selected" : null)">Highest priority</option>
                  <option value="@column.Index:priority:desc" selected="@(Model.EffectiveQuery.ColumnSorts.TryGetValue(column.Index, out var priorityDescSort) && priorityDescSort == new ItemSort(ItemSortField.Priority, true) ? "selected" : null)">Lowest priority</option>
                  <option value="@column.Index:title:asc" selected="@(Model.EffectiveQuery.ColumnSorts.TryGetValue(column.Index, out var titleSort) && titleSort == new ItemSort(ItemSortField.Title, false) ? "selected" : null)">Title A–Z</option>
                  <option value="@column.Index:title:desc" selected="@(Model.EffectiveQuery.ColumnSorts.TryGetValue(column.Index, out var titleDescSort) && titleDescSort == new ItemSort(ItemSortField.Title, true) ? "selected" : null)">Title Z–A</option>
                  <option value="@column.Index:number:asc" selected="@(Model.EffectiveQuery.ColumnSorts.TryGetValue(column.Index, out var numberSort) && numberSort == new ItemSort(ItemSortField.Number, false) ? "selected" : null)">Item number</option>
                  <option value="@column.Index:number:desc" selected="@(Model.EffectiveQuery.ColumnSorts.TryGetValue(column.Index, out var numberDescSort) && numberDescSort == new ItemSort(ItemSortField.Number, true) ? "selected" : null)">Item number, descending</option>
                </select>
                <button type="button" class="sort-direction" data-sort-direction-for="column-sort-@column.Index"
                        aria-pressed="false" aria-label="Default ordering has no direction toggle" disabled>↕</button>
              </span>
            </label>
          </header>
          <div class="cards">
            @if (column.Cards.Count == 0)
            {
              <p class="column-empty">No items match the current filters.</p>
            }
            @foreach (var card in column.Cards)
            {
              <partial name="Shared/_Card" model="card" />
            }
          </div>
        </section>
      }
    </div>
    @if (Model.Scope == "all" && Model.Archived.Count > 0)
    {
      <partial name="Shared/_Archived" model="Model.Archived" />
    }
    }
  }
</section>
