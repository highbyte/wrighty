@model ItemPageModel
<article class="detail" data-item-id="@Model.Id">
  <header class="detail-header">
    <div><span class="display-id">@Model.DisplayId</span><h2 tabindex="-1">@Model.Title</h2></div>
    <button type="button" class="close-panel" aria-label="Close details">×</button>
  </header>
  @if (Model.Notice is not null){<p class="notice" role="status">@Model.Notice</p>}
  @if (Model.ErrorCode is not null){<p class="error" role="alert"><strong>@Model.ErrorCode</strong> @Model.ErrorMessage</p>}
  @if (Model.WebMutationProtectionMessage is not null){<p class="notice" role="status">@Model.WebMutationProtectionMessage</p>}
  @if (Model.CreatedAt is not null || Model.UpdatedAt is not null)
  {
    <dl class="item-timestamps" aria-label="Item timestamps">
      @if (Model.CreatedAt is { } createdAt)
      {
        <div><dt>Created</dt><dd><time datetime="@createdAt.ToString("O")">@createdAt.ToLocalTime().ToString("g")</time></dd></div>
      }
      @if (Model.UpdatedAt is { } updatedAt)
      {
        <div><dt>Updated</dt><dd><time datetime="@updatedAt.ToString("O")">@updatedAt.ToLocalTime().ToString("g")</time></dd></div>
      }
    </dl>
  }
  @if (Model.DispatchState == DispatchStates.RetryScheduled)
  {
    <aside class="worker-state-callout retry-scheduled" role="status">
      <strong>Retry scheduled</strong>
      @if (Model.Dispatch is { } dispatch)
      {
        <span>
          Retry @(dispatch.SessionAgent ?? "the recorded agent") no earlier than
          @dispatch.NotBefore.ToLocalTime().ToString("g")
          (attempt @dispatch.Attempt of @dispatch.MaxAttempts).
          @dispatch.Reason
        </span>
      }
      else
      {
        <span>Scheduled on another Wrighty installation; exact retry details are unavailable here.</span>
      }
    </aside>
  }
  else if (Model.OperationalStatus == OperationalStatuses.NeedsAttention)
  {
    <aside class="worker-state-callout needs-attention" role="status">
      <strong>Agent needs attention</strong>
      <span>The recorded session is paused. Clarify the requirements, then queue it for a continuous worker or continue it explicitly.</span>
    </aside>
  }
  else if (Model.OperationalStatus == OperationalStatuses.Queued)
  {
    <aside class="worker-state-callout queued" role="status">
      <strong>Resume queued</strong>
      <span>A continuous worker can claim this item and resume its recorded agent session.</span>
    </aside>
  }
  else if (Model.OperationalStatus == OperationalStatuses.HandoffQueued)
  {
    <aside class="worker-state-callout handoff-queued" role="status">
      <strong>Handoff queued</strong>
      @if (Model.Dispatch is { } dispatch)
      {
        <span>@(dispatch.SessionAgent ?? "Agent") → @(dispatch.Agent ?? "agent"). @dispatch.Reason</span>
      }
      else
      {
        <span>Queued on another Wrighty installation; exact handoff details are unavailable here.</span>
      }
    </aside>
  }
  else if (Model.OperationalStatus == OperationalStatuses.WorkerPreparing)
  {
    <aside class="worker-state-callout worker-preparing" role="status">
      <strong>Worker preparing</strong>
      <span>The worker owns this item while it prepares the workspace and validates launch policy. No agent process has started yet.</span>
    </aside>
  }
  else if (Model.OperationalStatus == OperationalStatuses.AgentActive)
  {
    <aside class="worker-state-callout agent-active" role="status">
      <strong>@(Model.AgentLabel ?? "Agent") working</strong>
      <span>The worker successfully started the agent process and is maintaining its claim.</span>
    </aside>
  }
  else if (Model.OperationalStatus == OperationalStatuses.Completed)
  {
    <aside class="worker-state-callout completed" role="status">
      <strong>Completed</strong>
      <span>The agent finished this item and the work landed. The recorded session can still be reopened, but the usual next step is to finalize or archive it.</span>
    </aside>
  }
  @if (Model.ProviderBlock is { } provider)
  {
    <aside class="worker-state-callout provider-unavailable" role="status">
      <strong>
        @(provider.HasCapacityFailure
          ? $"{provider.AgentLabel} capacity unavailable"
          : $"{provider.AgentLabel} capacity probe in progress")
      </strong>
      <span>
        @if (provider.ProbeInProgress)
        {
          <text>Another worker is already performing the single capacity probe</text>
        }
        else
        {
          <text>Automatic workers will leave this otherwise-ready item unclaimed</text>
        }
        @if (provider.Until is { } until)
        {
          <text> until @until.ToLocalTime().ToString("g")</text>
        }.
        @provider.Reason
      </span>
      <span>
        To intentionally override the provider circuit, run
        <code>wrighty worker --item @Model.Id --yes</code>.
      </span>
      @if (provider.ProbeInProgress)
      {
        <button type="button" disabled>Probe in progress</button>
      }
      else
      {
        <form hx-post="/?handler=ProbeProvider"
              hx-target="#item-panel"
              hx-swap="innerHTML"
              hx-request='{"timeout":130000}'
              hx-disabled-elt="find button"
              data-confirm-title="Probe @provider.AgentLabel capacity?"
              data-confirm-message="This starts a small vendor request, may consume subscription usage, and does not claim this item."
              data-confirm-action="Probe @provider.AgentLabel">
          @Html.AntiForgeryToken()
          <input type="hidden" name="agent" value="@provider.Agent">
          <input type="hidden" name="id" value="@Model.Id">
          <button type="submit">Probe @provider.AgentLabel now</button>
        </form>
      }
    </aside>
  }
  @if (Model.LastRun is { } lastRun)
  {
    <aside class="last-run last-run-@lastRun.Label" role="status">
      <strong>Last run: @lastRun.Label</strong>
      @if (lastRun.EndedAt is { } endedAt)
      {
        <span class="last-run-when">Ended @endedAt.ToString("u")</span>
      }
      @if (lastRun.Failure is { } failure)
      {
        <span>
          @failure.Kind.ToString() (@failure.Confidence.ToString().ToLowerInvariant())
          @if (!string.IsNullOrWhiteSpace(failure.ProviderCode))
          {
            <text> · provider code @failure.ProviderCode</text>
          }
        </span>
      }
      @if (!string.IsNullOrWhiteSpace(lastRun.FinalMessage))
      {
        <pre class="last-run-message">@lastRun.FinalMessage</pre>
      }
      @if (lastRun.AgentReport is { } report)
      {
        @* Labelled at the heading, as in the CLI and the published comment: this is the agent's
           account, while the outcome above it is what Wrighty observed. *@
        <div class="agent-report">
          <strong>Agent report</strong>
          <span class="agent-report-caveat">the agent&#39;s account, not verified by Wrighty</span>
          @if (!string.IsNullOrWhiteSpace(report.Summary))
          {
            <p class="agent-report-summary">@report.Summary</p>
          }
          @foreach (var (heading, items) in new (string, IReadOnlyList<string>?)[]
                    {
                        ("Changed", report.Changes),
                        ("Checks the agent says it ran", report.Verification),
                        ("Decisions and assumptions", report.Decisions),
                        ("Input requested", report.RequestedInput),
                        ("Remaining work", report.RemainingWork)
                    })
          {
            @if (items is { Count: > 0 })
            {
              <div class="agent-report-section">
                <em>@heading</em>
                <ul>
                  @foreach (var entry in items)
                  {
                    <li>@entry</li>
                  }
                </ul>
              </div>
            }
          }
          @if (!string.IsNullOrWhiteSpace(report.AgentReportedBody))
          {
            <pre class="last-run-message">@report.AgentReportedBody</pre>
          }
        </div>
      }
    </aside>
  }
  <section class="metadata-group">
    <h3>Item</h3>
    <dl class="metadata">
      <div><dt>Status</dt><dd>@(Model.Status ?? "No status")</dd></div>
      <div><dt>Priority</dt><dd>@(Model.Priority ?? "None")</dd></div>
      <div><dt>Operational status</dt><dd>@Model.OperationalStatus.Replace('-', ' ')</dd></div>
    </dl>
  </section>
  <section class="metadata-group">
    <h3>Execution policy</h3>
    <dl class="metadata">
      <div><dt>Automatic execution</dt><dd>@(Model.AutomaticExecutionAllowed ? "Allowed" : "Manual only")</dd></div>
      <div><dt>Agent</dt><dd>@Model.AgentPolicyDisplay</dd></div>
      <div><dt>Execution profile</dt><dd>@Model.ExecutionProfileDisplay</dd></div>
    </dl>
  </section>
  <section class="metadata-group">
    <h3>Current claim</h3>
    <dl class="metadata">
      <div><dt>State</dt><dd>@Model.ClaimLabel</dd></div>
    @if (Model.ClaimantKindLabel is not null)
    {
      <div><dt>Claimant type</dt><dd>@Model.ClaimantKindLabel</dd></div>
    }
    @if (Model.AgentLabel is not null)
    {
      <div><dt>Agent</dt><dd>@Model.AgentLabel</dd></div>
    }
    @if (Model.ClaimState != ClaimOwnershipState.Unclaimed && Model.ClaimantId is not null)
    {
      <div class="metadata-technical" data-copy-scope>
        <dt>Claimant ID</dt>
        <dd class="inspectable-value">
          <code id="claimant-id-value" class="inspectable-value-text">@Model.ClaimantId</code>
          <span class="inspectable-value-actions">
            <button type="button" class="expand-value-button" data-expand-target="claimant-id-value" aria-controls="claimant-id-value" aria-expanded="false">Show full</button>
            <button type="button" class="copy-button" data-copy-target="claimant-id-value" data-copy-name="Claimant ID">Copy</button>
          </span>
          <span class="copy-feedback" role="status" aria-live="polite"></span>
        </dd>
      </div>
    }
    </dl>
  </section>
  @if (Model.Dispatch is { } pendingDispatch)
  {
    <section class="metadata-group">
      <h3>Pending dispatch</h3>
      <dl class="metadata">
        <div><dt>State</dt><dd>@pendingDispatch.State.Replace('-', ' ')</dd></div>
        @if (!string.IsNullOrWhiteSpace(pendingDispatch.Agent))
        {
          <div><dt>Agent</dt><dd>@pendingDispatch.Agent</dd></div>
        }
        @if (!string.IsNullOrWhiteSpace(pendingDispatch.SessionAgent) &&
             !string.Equals(pendingDispatch.SessionAgent, pendingDispatch.Agent, StringComparison.OrdinalIgnoreCase))
        {
          <div><dt>Session agent</dt><dd>@pendingDispatch.SessionAgent</dd></div>
        }
        <div><dt>Not before</dt><dd>@pendingDispatch.NotBefore.ToLocalTime().ToString("g")</dd></div>
        <div><dt>Attempt</dt><dd>@pendingDispatch.Attempt of @pendingDispatch.MaxAttempts</dd></div>
        <div><dt>Detail</dt><dd>@pendingDispatch.Reason</dd></div>
      </dl>
    </section>
  }
  @if (Model.SessionAgentLabel is not null || Model.SessionId is not null || Model.Workspace is not null)
  {
    <section class="metadata-group">
      <h3>Session</h3>
      <dl class="metadata">
    @if (Model.SessionAgentLabel is not null)
    {
      <div><dt>Agent</dt><dd>@Model.SessionAgentLabel</dd></div>
    }
    @if (Model.SessionId is not null)
    {
      <div class="metadata-technical"><dt>Session ID</dt><dd><code>@Model.SessionId</code></dd></div>
    }
    @if (Model.Workspace is { Removed: true })
    {
      @* The recorded worktree was removed (e.g. cleaned up after completion). The durable session
         is kept for the record, but the branch/path no longer exist, so collapse them into one
         honest line rather than surfacing a dead path. *@
      <div><dt>Worktree</dt><dd>Removed — no longer present on this host</dd></div>
    }
    else if (Model.Workspace is { } workspace)
    {
      @if (workspace.Branch is not null)
      {
        <div><dt>Worker branch</dt><dd><code>@workspace.Branch</code></dd></div>
      }
      @if (workspace.StatusAvailable)
      {
        <div><dt>Working tree</dt><dd>@(workspace.Dirty ? "Dirty (uncommitted changes)" : "Clean")</dd></div>
        <div><dt>Branch state</dt><dd>@(workspace.Merged ? "Merged into HEAD" : "Unmerged")</dd></div>
      }
      else
      {
        <div><dt>Worktree status</dt><dd>@workspace.Unavailable</dd></div>
      }
      <div class="metadata-technical" data-copy-scope>
        <dt>Workspace path</dt>
        <dd class="inspectable-value">
          <code id="workspace-path-value" class="inspectable-value-text">@workspace.Path</code>
          <span class="inspectable-value-actions">
            <button type="button" class="expand-value-button" data-expand-target="workspace-path-value" aria-controls="workspace-path-value" aria-expanded="false">Show full</button>
            <button type="button" class="copy-button" data-copy-target="workspace-path-value" data-copy-name="Workspace path">Copy</button>
          </span>
          <span class="copy-feedback" role="status" aria-live="polite"></span>
        </dd>
      </div>
    }
      </dl>
    </section>
  }
  @if (Model.EffectiveFields.Count > 0)
  {
    <details class="custom-fields">
      <summary>Custom fields (@Model.EffectiveFields.Count)</summary>
      <dl class="custom-field-list">
        @{ var fieldIndex = 0; }
        @foreach (var field in Model.EffectiveFields.OrderBy(pair => pair.Key, StringComparer.Ordinal))
        {
          var fieldValueId = $"custom-field-value-{fieldIndex++}";
          <div data-copy-scope>
            <dt>@field.Key</dt>
            <dd class="custom-field-value">
              <code id="@fieldValueId">@field.Value</code>
              <button type="button" class="copy-button" data-copy-target="@fieldValueId" data-copy-name="@field.Key custom field">Copy</button>
              <span class="copy-feedback" role="status" aria-live="polite"></span>
            </dd>
          </div>
        }
      </dl>
    </details>
  }
  <partial name="_ResumeAddress" model="Model" />
  <partial name="_CompleteWorktree" model="Model" />
  @if (Model.RawFrontmatter is not null)
  {
    <details class="frontmatter"><summary>Frontmatter</summary><pre><code class="language-yaml">@Model.RawFrontmatter</code></pre></details>
  }
  <div class="tabs" role="tablist" aria-label="Markdown view">
    <button id="rendered-tab" type="button" class="tab active" role="tab" aria-selected="true" aria-controls="rendered-panel">Rendered</button>
    <button id="raw-tab" type="button" class="tab" role="tab" aria-selected="false" aria-controls="raw-panel" tabindex="-1">Raw Markdown</button>
  </div>
  <div id="rendered-panel" class="markdown" role="tabpanel" aria-labelledby="rendered-tab" hx-disable>@Model.RenderedBody</div>
  <pre id="raw-panel" class="raw" role="tabpanel" aria-labelledby="raw-tab" hidden><code>@Model.Body</code></pre>
  <footer class="actions">
    @if (Model.Archived)
    {
      <div class="actions-primary">
        <form hx-post="/?handler=Unarchive" hx-target="#item-panel" hx-swap="innerHTML">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="primary">Unarchive</button></form>
      </div>
    }
    else if (Model.ClaimState == ClaimOwnershipState.Unclaimed)
    {
      <div class="actions-secondary">
        <form hx-post="/?handler=Claim" hx-target="#item-panel" hx-swap="innerHTML">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="@(Model.CanQueueForWorker ? null : "primary")">Claim for editing</button></form>
        <form hx-post="/?handler=ClaimAndArchive" hx-target="#item-panel" hx-swap="innerHTML" data-confirm-title="Archive this item?" data-confirm-message="Wrighty claims it, moves it to the archive, and preserves the recorded session." data-confirm-action="Archive" data-confirm-tone="danger">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="danger has-tooltip" aria-describedby="archive-unclaimed-help" data-tooltip="Claim and archive this item in one step. The recorded session is preserved.">Archive</button></form>
        <span id="archive-unclaimed-help" class="visually-hidden">Claim and archive this item in one step. The recorded session is preserved.</span>
        @if (Model.CanDelete)
        {
          <form hx-post="/?handler=Delete" hx-target="#item-panel" hx-swap="innerHTML" data-confirm-title="Permanently delete this item?" data-confirm-message="This unprocessed item and its local Markdown file will be permanently deleted. This cannot be undone." data-confirm-action="Delete permanently" data-confirm-tone="danger">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="danger has-tooltip" aria-describedby="delete-help" data-tooltip="Permanently delete this unprocessed item. This cannot be undone.">Delete</button></form>
          <span id="delete-help" class="visually-hidden">Permanently delete this unprocessed item. This cannot be undone.</span>
        }
      </div>
      @if (Model.CanQueueForWorker)
      {
        <div class="actions-primary">
          <form hx-post="/?handler=QueueForWorker" hx-target="#item-panel" hx-swap="innerHTML" data-confirm-title="Queue this session for automatic resume?" data-confirm-message="The work item instructions will not be changed." data-confirm-action="Queue for worker">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="primary">Queue for worker</button></form>
        </div>
      }
    }
    else if (Model.ClaimState == ClaimOwnershipState.OwnedByCurrent && !Model.WebMutationProtected)
    {
      <div class="actions-secondary">
        @if (Model.HasResumeAddress)
        {
          <form hx-post="/?handler=Release" hx-target="#item-panel" hx-swap="innerHTML" data-confirm-title="Release this claim?" data-confirm-message="The item returns to the pool; the recorded agent session remains available." data-confirm-action="Release claim">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="has-tooltip" aria-describedby="release-help" data-tooltip="Release the claim. The recorded agent session remains available for later resume.">Release claim</button></form>
          <span id="release-help" class="visually-hidden">Release the claim. The recorded agent session remains available for later resume.</span>
        }
        else
        {
          <form hx-post="/?handler=Release" hx-target="#item-panel" hx-swap="innerHTML">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="has-tooltip" aria-describedby="release-help" data-tooltip="Release the claim so another claimant can claim this item.">Release</button></form>
          <span id="release-help" class="visually-hidden">Release the claim so another claimant can claim this item.</span>
        }
        <form hx-post="/?handler=Archive" hx-target="#item-panel" hx-swap="innerHTML">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="danger has-tooltip" aria-describedby="archive-help" data-tooltip="Move this item to the archive and release its claim.">Archive</button></form>
        <span id="archive-help" class="visually-hidden">Move this item to the archive and release its claim.</span>
      </div>
      <div class="actions-primary">
        @if (Model.CanQueueForWorker)
        {
          <form hx-post="/?handler=QueueForWorker" hx-target="#item-panel" hx-swap="innerHTML" data-confirm-title="Queue this session for automatic resume?" data-confirm-message="The work item instructions will not be changed." data-confirm-action="Queue for worker">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="primary">Queue for worker</button></form>
        }
        <form hx-get="/?handler=Edit" hx-target="#item-panel" hx-swap="innerHTML"><input type="hidden" name="id" value="@Model.Id"><button class="@(Model.CanQueueForWorker ? null : "primary")">Edit</button></form>
      </div>
    }
    else if (Model.TakeoverAvailable)
    {
      <div class="actions-secondary">
        <form hx-post="/?handler=OverrideRelease" hx-target="#item-panel" hx-swap="innerHTML" data-confirm-title="Release the existing claim?" data-confirm-message="The previous claimant may still have work in progress, and this does not stop its process. A recorded agent session remains available." data-confirm-action="Release existing claim" data-confirm-tone="danger">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button>Release existing claim…</button></form>
      </div>
      <div class="actions-primary">
        @if (Model.CanQueueForWorker)
        {
          <form hx-post="/?handler=QueueForWorker" hx-target="#item-panel" hx-swap="innerHTML" data-confirm-title="Queue this session for automatic resume?" data-confirm-message="The work item instructions will not be changed." data-confirm-action="Queue for worker">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="primary">Queue for worker</button></form>
        }
        <form hx-post="/?handler=Takeover"
              hx-target="#item-panel"
              hx-swap="innerHTML"
              data-confirm-title="@(Model.OperationalStatus == OperationalStatuses.NeedsAttention ? "Take over the paused session for editing?" : "Take over for editing?")"
              data-confirm-message="@(Model.OperationalStatus == OperationalStatuses.NeedsAttention ? "This rotates the retained claim and fences later cooperating Wrighty mutations from the previous claimant." : "This does not stop the previous process. Later cooperating Wrighty mutations will be rejected, but a mutation already executing may finish first.")"
              data-confirm-action="Take over">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="primary">Take over for editing…</button></form>
      </div>
    }
  </footer>
</article>
