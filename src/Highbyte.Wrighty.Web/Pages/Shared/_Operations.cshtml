@model Highbyte.Wrighty.Web.OperationsPageModel
@using System.Text.Json
<section id="operations-content"
         class="operations"
         aria-live="polite">
  <header class="operations-heading">
    <div>
      <span class="eyebrow">OPERATIONS</span>
      <h2>Repository control plane</h2>
      @if (Model.TargetDescription is not null)
      {
        <span class="target-description">@Model.TargetDescription</span>
      }
    </div>
    <div class="target-actions">
      <button id="refresh-operations"
              type="button"
              hx-get="/?handler=Operations"
              hx-target="#operations-content"
              hx-swap="outerHTML">Refresh operations</button>
      @if (Model.TargetUrl is not null)
      {
        <a class="target-link" href="@Model.TargetUrl" target="_blank" rel="noreferrer">Open GitHub repository</a>
        <form method="post" hx-post="/?handler=ValidateTarget" hx-target="#operations-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <button id="validate-github-target" type="submit">Validate GitHub target</button>
        </form>
      }
    </div>
  </header>

  @if (Model.Notice is not null)
  {
    <output id="configuration-save-notice" class="notice">@Model.Notice</output>
  }
  @if (Model.TargetNotice is not null)
  {
    <output id="github-target-health" class="notice">@Model.TargetNotice</output>
  }
  @if (Model.TargetErrorCode is not null)
  {
    <div id="github-target-health" class="error" role="alert"><strong>@Model.TargetErrorCode</strong> @Model.TargetErrorMessage</div>
  }

  <div class="operations-grid">
    <section id="operational-items" class="operations-card">
      <header><h3>Operational items</h3><span>@Model.Items.Count</span></header>
      @if (Model.OperationsErrorCode is not null)
      {
        <div class="error" role="alert"><strong>@Model.OperationsErrorCode</strong> @Model.OperationsErrorMessage</div>
      }
      else if (Model.Items.Count == 0)
      {
        <p class="empty-state">No work items were returned by the configured backend.</p>
      }
      else
      {
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Item</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Operational</th>
                <th>Recovery</th>
                @if (Model.Capabilities.ContextApproval)
                {
                  <th>Context</th>
                  <th class="operations-action-cell">Actions</th>
                }
              </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
              <tr>
                <td>
                  @if (item.Url is not null)
                  {
                    <a href="@item.Url" target="_blank" rel="noreferrer">@item.Id · @item.Title</a>
                  }
                  else
                  {
                    <span>@item.Id · @item.Title</span>
                  }
                </td>
                <td>@(item.Status ?? "—")</td>
                <td>@(item.Priority ?? "—")</td>
                <td>@item.OperationalStatus</td>
                <td>@(item.Recovery ?? "—")</td>
                @if (Model.Capabilities.ContextApproval)
                {
                  <td class="context-approval-cell">
                    <span id="context-approval-state-@item.AutomationKey"
                          class="state-pill context-approval-@item.ContextApprovalAppearance"
                          title="@item.ContextApprovalTitle">@item.ContextApprovalLabel</span>
                  </td>
                  <td class="operations-action-cell">
                    <button id="context-approval-inspect-@item.AutomationKey"
                            type="button"
                            data-panel-loading-label="Loading context approval…"
                            hx-get="/?handler=ContextApproval&amp;id=@Uri.EscapeDataString(item.Id)"
                            hx-target="#item-panel"
                            hx-swap="innerHTML">Inspect</button>
                  </td>
                }
              </tr>
            }
            </tbody>
          </table>
        </div>
      }
    </section>

    <section class="operations-card">
      <header><h3>Local worker processes</h3><span>@Model.Workers.Count</span></header>
      @if (Model.Workers.Count == 0)
      {
        <p class="empty-state">No worker process is registered for this repository configuration.</p>
      }
      else
      {
        <div class="worker-list">
        @foreach (var worker in Model.Workers)
        {
          <article id="worker-instance-@worker.Instance.RunId" class="worker-row">
            <div>
              <strong>@worker.Instance.InvocationSummary</strong>
              <span>PID @worker.Instance.ProcessId · @worker.Instance.State · @(worker.Instance.CurrentItemId ?? "idle")</span>
            </div>
            <span class="state-pill state-@worker.Liveness.ToString().ToLowerInvariant()">@worker.Liveness</span>
            <small>heartbeat @worker.Instance.LastHeartbeatAt.ToLocalTime().ToString("g") · config @worker.Instance.ConfigurationRevision[..Math.Min(10, worker.Instance.ConfigurationRevision.Length)]</small>
            @if (worker.Detail is not null) { <small>@worker.Detail</small> }
          </article>
        }
        </div>
      }
    </section>
  </div>

  <section class="operations-card configuration-card">
    <header>
      <div>
        <h3>Repository configuration</h3>
        <span>Scope: repository · typed, revision-checked updates</span>
        @if (Model.Configuration is not null)
        {
          <span title="@Model.Configuration.SourcePath">Source: @Model.Configuration.SourcePath</span>
        }
      </div>
      @if (Model.Configuration is not null)
      {
        <code>schema @Model.Configuration.SchemaVersion · stored @Model.Configuration.Revision[..10] · active @(Model.ActiveConfigurationRevision is null ? "unknown" : Model.ActiveConfigurationRevision[..10])</code>
      }
    </header>
    @if (Model.ConfigurationErrorCode is not null)
    {
      <div id="configuration-validation-summary" class="error" role="alert"><strong>@Model.ConfigurationErrorCode</strong> @Model.ConfigurationErrorMessage</div>
    }
    @if (Model.Configuration is { } configuration)
    {
      var current = configuration.StoredConfiguration;
      var draft = Model.ConfigurationDraft;
      var workflowDraft = draft?.Operation == "workflow";
      var workerDraft = draft?.Operation == "worker";
      var completionDraft = draft?.Operation == "completion";
      var archiveDraft = draft?.Operation == "archive";
      var webDraft = draft?.Operation == "web";
      var profilesDraft = draft?.Operation == "profiles";
      var webDrift = Model.ActiveConfigurationRevision is not null &&
        !string.Equals(Model.ActiveConfigurationRevision, configuration.Revision, StringComparison.Ordinal);
      var workerDrift = Model.Workers.Count(worker =>
        !string.Equals(worker.Instance.ConfigurationRevision, configuration.Revision, StringComparison.Ordinal));
      @if (webDrift || workerDrift > 0)
      {
        <output id="configuration-restart-warning" class="warning">
          Saved configuration differs from
          @(webDrift ? "this web process" : string.Empty)@((webDrift && workerDrift > 0) ? " and " : string.Empty)@(workerDrift > 0 ? $"{workerDrift} local worker process(es)" : string.Empty).
          Restart the affected processes before relying on the new policy.
        </output>
      }
      else if (Model.ActiveConfigurationRevision is null)
      {
        <output id="configuration-restart-warning" class="warning">
          Running workers are not reconfigured automatically. Restart any worker using this configuration after a save.
        </output>
      }
      @if (configuration.RequiresCanonicalizationApproval)
      {
        <div class="warning" role="note">This file contains comments or trailing commas. Saving rewrites it as canonical JSON and requires explicit approval below.</div>
      }
      @if (configuration.LegacyProperties is { Count: > 0 } legacyProperties)
      {
        <div class="warning" role="note">This file contains values written by an earlier Wrighty version: @string.Join(", ", legacyProperties). They are not settings and are ignored. Saving any section below removes them, whether or not you change a value.</div>
      }
      <div class="configuration-forms">
        <form id="configuration-workflow-form" method="post" hx-post="/?handler=Configuration" hx-target="#operations-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="workflow">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Workflow defaults</h4>
          <label>Pick from <input id="configuration-default-pick-from" name="defaultPickFrom" value="@(workflowDraft ? draft!.DefaultPickFrom : current.DefaultPickFrom)" required></label>
          <label>Pick to <input id="configuration-default-pick-to" name="defaultPickTo" value="@(workflowDraft ? draft!.DefaultPickTo : current.DefaultPickTo)" required></label>
          <label>Finish to <input id="configuration-default-finish-to" name="defaultFinishTo" value="@(workflowDraft ? draft!.DefaultFinishTo : current.DefaultFinishTo)" required></label>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(workflowDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit">Save workflow</button>
        </form>

        <form id="configuration-worker-form" method="post" hx-post="/?handler=Configuration" hx-target="#operations-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="worker">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Worker defaults</h4>
          <label>Default agent
            <select id="configuration-default-agent" name="defaultAgent">
              <option value="" selected="@((workerDraft ? draft!.DefaultAgent : current.EffectiveWorker.DefaultAgent) is null or "")">Item or invocation policy</option>
              @foreach (var agent in new[] { "claude", "codex", "copilot" })
              {
                <option value="@agent" selected="@(agent == (workerDraft ? draft!.DefaultAgent : current.EffectiveWorker.DefaultAgent))">@agent</option>
              }
            </select>
          </label>
          <label>Workspace mode
            <select id="configuration-workspace-mode" name="workspaceMode">
              @foreach (var mode in new[] { "current", "shared", "worktree" })
              {
                <option value="@mode" selected="@(mode == (workerDraft ? draft!.WorkspaceMode : current.EffectiveWorker.WorkspaceMode ?? "current"))">@mode</option>
              }
            </select>
          </label>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(workerDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit">Save worker defaults</button>
        </form>

        <form id="configuration-completion-form" method="post" hx-post="/?handler=Configuration" hx-target="#operations-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="completion">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Completion policy</h4>
          <label>Commit
            <select id="configuration-completion-commit" name="completionCommit">
              @foreach (var value in new[] { "inspect", "agent" })
              {
                <option value="@value" selected="@(value == (completionDraft ? draft!.CompletionCommit : current.EffectiveWorker.Completion?.Commit ?? "inspect"))">@value</option>
              }
            </select>
          </label>
          <label>Integration
            <select id="configuration-completion-integration" name="completionIntegration">
              @foreach (var value in new[] { "none", "merge-local", "push-pr" })
              {
                <option value="@value" selected="@(value == (completionDraft ? draft!.CompletionIntegration : current.EffectiveWorker.Completion?.Integration ?? "none"))">@value</option>
              }
            </select>
          </label>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(completionDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit">Save completion</button>
        </form>

        <form id="configuration-archive-form" method="post" hx-post="/?handler=Configuration" hx-target="#operations-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="archive">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Archive policy</h4>
          <label>Archive on statuses
            <input id="configuration-archive-statuses" name="archiveStatuses" value="@(archiveDraft ? draft!.ArchiveStatuses : string.Join(", ", current.Archive.OnStatuses))" placeholder="Done, Cancelled">
          </label>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(archiveDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit">Save archive policy</button>
        </form>

        <form id="configuration-profiles-form" method="post" hx-post="/?handler=Configuration" hx-target="#operations-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="profiles">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Execution profiles</h4>
          <label>Profile names this repository recognizes
            <input id="configuration-execution-profiles" name="executionProfiles"
                   value="@(profilesDraft ? draft.ExecutionProfiles : string.Join(", ", current.EffectiveWorker.EffectiveExecutionProfiles))"
                   placeholder="economy, balanced, deep">
          </label>
          <label>Applied when neither the run nor the item names one
            <input id="configuration-default-execution-profile" name="defaultExecutionProfile"
                   value="@(profilesDraft ? draft.DefaultExecutionProfile : current.EffectiveWorker.DefaultExecutionProfile)"
                   placeholder="none">
          </label>
          <p class="muted">
            Shared policy: these names are committed and everyone on the project sees them. What each
            one resolves to in vendor terms is decided per machine, below.
          </p>
          @if (Model.Backend == "github")
          {
            <p class="muted">
              <strong>Removing a name is not only a file edit.</strong> The next <code>wrighty init</code>
              deletes the matching board option, which clears the profile from every item still holding
              it. Those items fall back to the repository default on their next run.
            </p>
          }
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(profilesDraft && draft.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit">Save execution profiles</button>
        </form>

        <form id="configuration-web-form" method="post" hx-post="/?handler=Configuration" hx-target="#operations-content" hx-swap="outerHTML">
          @Html.AntiForgeryToken()
          <input type="hidden" name="operation" value="web">
          <input type="hidden" name="revision" value="@configuration.Revision">
          <h4>Web policy</h4>
          <label>Protect non-human claims
            <select id="configuration-protect-non-human-claims" name="protectNonHumanClaims">
              <option value="true" selected="@(webDraft ? draft!.ProtectNonHumanClaims : current.EffectiveWeb.ProtectNonHumanClaims)">true</option>
              <option value="false" selected="@(webDraft ? !draft!.ProtectNonHumanClaims : !current.EffectiveWeb.ProtectNonHumanClaims)">false</option>
            </select>
          </label>
          @if (configuration.RequiresCanonicalizationApproval)
          {
            <label class="checkbox-field"><input type="checkbox" name="approveCanonicalization" value="true" checked="@(webDraft && draft!.ApproveCanonicalization)">Approve JSON normalization</label>
          }
          <button type="submit">Save web policy</button>
        </form>
      </div>

      @if (Model.UserConfiguration is { } user)
      {
        <div class="user-configuration">
          <h3>This machine</h3>
          <p class="muted">
            Settings that stay on this computer. They describe your installation rather than the
            project, so they are never written to <code>.wrighty.json</code> and never travel to
            anyone else.
          </p>
          <p class="muted"><code>@user.SourcePath</code>@(user.Exists ? "" : " (not created yet)")</p>
          @if (user.AwaitingMigration)
          {
            <p class="muted">Reading the previous settings version; the next save rewrites it.</p>
          }

          <div class="configuration-forms">
          <form id="user-configuration-host-form" method="post" hx-post="/?handler=UserConfiguration"
                hx-target="#operations-content" hx-swap="outerHTML">
            @Html.AntiForgeryToken()
            <input type="hidden" name="operation" value="hostLabel">
            <input type="hidden" id="user-configuration-revision" name="revision" value="@user.Revision">
            <h4>Host label</h4>
            <label>Shown when this machine hands work over
              <input id="user-configuration-host-label" name="hostLabel"
                     value="@(user.Stored.HostLabel ?? string.Empty)"
                     placeholder="@Highbyte.Wrighty.Settings.HostLabelProvider.AnonymousLabel">
            </label>
            <p class="muted">Leave empty to hand over as
              <code>@Highbyte.Wrighty.Settings.HostLabelProvider.AnonymousLabel</code>.</p>
            <button type="submit">Save host label</button>
          </form>
          </div>

          @{
            var vocabulary = current.EffectiveWorker.EffectiveExecutionProfiles.Count > 0
              ? current.EffectiveWorker.EffectiveExecutionProfiles
              : Highbyte.Wrighty.Workers.BuiltInExecutionProfiles.Names;
          }
          <div class="configuration-forms">
          @foreach (var catalog in Model.AgentModels)
          {
            <form id="profile-mapping-@catalog.Agent-form" method="post" hx-post="/?handler=ProfileMapping"
                  hx-target="#operations-content" hx-swap="outerHTML">
              @Html.AntiForgeryToken()
              <input type="hidden" name="revision" value="@user.Revision">
              <input type="hidden" name="agent" value="@catalog.Agent">
              <h4>@catalog.Agent</h4>
              <label>Profile
                <select name="profile">
                  @foreach (var name in vocabulary)
                  {
                    <option value="@name">@name</option>
                  }
                </select>
              </label>
              <label>Model
                @if (catalog.Succeeded && catalog.Models.Count > 0)
                {
                  <select id="profile-mapping-@catalog.Agent-model" name="model">
                    <option value="">vendor default</option>
                    @foreach (var choice in catalog.Models)
                    {
                      <option value="@choice.Id">@AgentModelChoice.Describe(choice)</option>
                    }
                  </select>
                }
                else
                {
                  <input id="profile-mapping-@catalog.Agent-model" name="model" placeholder="vendor default">
                }
              </label>
              <label>Effort
                <select name="effort">
                  <option value="">vendor default</option>
                  @foreach (var level in Highbyte.Wrighty.Workers.ExecutionEfforts.All)
                  {
                    <option value="@level">@level</option>
                  }
                </select>
              </label>
              @if (!catalog.Succeeded)
              {
                <p class="muted">
                  @catalog.Agent could not be asked what it can run, so this is a free-text field and
                  nothing is checked against it. Saving still works.
                </p>
              }
              <button type="submit">Save @catalog.Agent mapping</button>
            </form>
          }
          </div>
          <p class="muted">
            Leaving both at "vendor default" removes the mapping. What a profile means is decided
            here, per machine — the names themselves are repository policy, above.
          </p>

          <details class="settings-catalog">
            <summary>Machine-local settings (@user.Settings.Count)</summary>
            <div class="table-scroll">
              <table>
                <thead><tr><th>Setting</th><th>Effective value</th><th>Source</th><th>Applies at</th><th>Edit mode</th></tr></thead>
                <tbody>
                @foreach (var setting in user.Settings)
                {
                  <tr>
                    <td><code>@setting.Id</code><small>@setting.Help</small></td>
                    <td><code>@JsonSerializer.Serialize(setting.EffectiveValue)</code></td>
                    <td>@setting.DefaultSource</td>
                    <td>@setting.EffectiveBoundary</td>
                    <td>@setting.EditMode</td>
                  </tr>
                }
                </tbody>
              </table>
            </div>
          </details>
        </div>
      }

      <details class="settings-catalog">
        <summary>Repository configuration catalogue (@configuration.Settings.Count settings)</summary>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Setting</th><th>Effective value</th><th>Source</th><th>Applies at</th><th>Edit mode</th></tr></thead>
            <tbody>
            @foreach (var setting in configuration.Settings)
            {
              <tr>
                <td><code>@setting.Id</code><small>@setting.Help</small></td>
                <td><code>@JsonSerializer.Serialize(setting.EffectiveValue)</code></td>
                <td>@setting.DefaultSource</td>
                <td>@setting.EffectiveBoundary</td>
                <td>@setting.EditMode</td>
              </tr>
            }
            </tbody>
          </table>
        </div>
      </details>
    }
  </section>
</section>

