@model Highbyte.Wrighty.Web.OperationsPageModel
@{
  var hasActions = Model.Capabilities.ContextApproval ||
    Model.Items.Any(item => item.EffectiveSessionActions.Count > 0);
  var query = Model.EffectiveQuery;
  string SortValue() => query.Sort == ItemSort.Default ? "default" : query.Sort.Key;
  string NextSort(ItemSortField field, bool defaultDescending = false) =>
    new ItemSort(
      field,
      query.Sort.Field == field ? !query.Sort.Descending : defaultDescending).Key;
  string? SortState(ItemSortField field)
  {
    if (query.Sort.Field != field) return null;
    return query.Sort.Descending ? "descending" : "ascending";
  }
  string SortIndicator(ItemSortField field)
  {
    if (query.Sort.Field != field) return "↕";
    return query.Sort.Descending ? "↓" : "↑";
  }
}
@* wrighty:refresh reaches body only when htmx raises it from a save response (HX-Trigger).
   The visible Operations poll uses its own non-bubbling event on this region. *@
<section id="operations-content"
         class="operations"
         aria-live="polite"
         data-attention-count="@Model.Items.Count(item => item.OperationalStatus == OperationalStatuses.NeedsAttention)"
         hx-get="/?handler=Operations"
         hx-trigger="wrighty:refresh from:body, wrighty:operations-refresh"
         hx-include="#operations-filters"
         hx-swap="outerHTML"
         hx-request='{"timeout":130000}'>
  <header class="operations-heading">
    <div>
      <span class="eyebrow">OPERATIONS</span>
      <h2>Repository control plane</h2>
      @if (Model.Target is { } target)
      {
        <span class="target-description">
          @target.Host ·
          <a id="github-repository-link"
             class="target-description-link"
             href="@target.RepositoryUrl"
             target="_blank"
             rel="noreferrer">@target.Repository</a>
          ·
          @if (target.ProjectUrl is not null)
          {
            <a id="github-project-link"
               class="target-description-link"
               href="@target.ProjectUrl"
               target="_blank"
               rel="noreferrer">@target.ProjectLabel</a>
          }
          else
          {
            <span>@target.ProjectLabel</span>
          }
        </span>
      }
    </div>
    <div class="target-actions">
      <button id="refresh-operations"
              class="request-button"
              type="button"
              hx-get="/?handler=Operations"
              hx-target="#operations-content"
              hx-swap="outerHTML"
              hx-include="#operations-filters"
              hx-indicator="this"
              hx-disabled-elt="this">
        <span class="request-button-idle">Refresh operations</span>
        <output class="request-button-progress">
          <span class="request-button-spinner" aria-hidden="true"></span>
          Refreshing…
        </output>
      </button>
      @if (Model.Target is not null)
      {
        <form method="post"
              hx-post="/?handler=ValidateTarget"
              hx-target="#operations-content"
              hx-swap="outerHTML"
              hx-indicator="#validate-github-target"
              hx-include="#operations-filters"
              hx-disabled-elt="#validate-github-target">
          @Html.AntiForgeryToken()
          <button id="validate-github-target" class="request-button" type="submit">
            <span class="request-button-idle">Validate GitHub target</span>
            <output class="request-button-progress">
              <span class="request-button-spinner" aria-hidden="true"></span>
              Validating…
            </output>
          </button>
        </form>
      }
    </div>
  </header>

  @if (Model.TargetNotice is not null)
  {
    <output id="github-target-health" class="notice">@Model.TargetNotice</output>
  }
  @if (Model.TargetErrorCode is not null)
  {
    <div id="github-target-health" class="error" role="alert"><strong>@Model.TargetErrorCode</strong> @Model.TargetErrorMessage</div>
  }
  @if (Model.WorkerErrorCode is not null)
  {
    <div id="worker-operation-error" class="error" role="alert"><strong>@Model.WorkerErrorCode</strong> @Model.WorkerErrorMessage</div>
  }

  <form id="operations-filters" class="operations-filters"
        hx-get="/?handler=Operations" hx-target="#operations-content" hx-swap="outerHTML">
    <input id="operations-sort" type="hidden" name="sort" value="@SortValue()">
    <label>Search
      <input type="search" name="search" value="@query.Search" autocomplete="off"
             placeholder="ID, title, status, or agent">
    </label>
    <label>Requested agent
      <select id="operations-agent-filter" name="agent">
        <option value="">Any</option>
        @foreach (var agent in Model.AgentOptions)
        {
          <option value="@agent.Id" selected="@(string.Equals(query.Agent, agent.Id, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@agent.DisplayName</option>
        }
      </select>
    </label>
    <label>Priority
      <select id="operations-priority-filter" name="priority">
        <option value="">Any</option>
        @foreach (var priority in Model.PriorityOptions)
        {
          <option value="@priority" selected="@(string.Equals(query.Priority, priority, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@priority</option>
        }
      </select>
    </label>
    <label>Workflow status
      <select id="operations-workflow-status-filter" name="workflowStatus">
        <option value="">Any</option>
        @foreach (var status in Model.WorkflowStatusOptions)
        {
          <option value="@status" selected="@(string.Equals(query.WorkflowStatus, status, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@status</option>
        }
      </select>
    </label>
    <label>Operational
      <select name="operationalStatus">
        <option value="">Any</option>
        @foreach (var value in new[] { OperationalStatuses.NeedsAttention, OperationalStatuses.AgentActive, OperationalStatuses.WorkerPreparing, OperationalStatuses.Queued, OperationalStatuses.RetryScheduled, OperationalStatuses.HandoffQueued, OperationalStatuses.Ready, OperationalStatuses.Completed })
        {
          <option value="@value" selected="@(query.OperationalStatus == value ? "selected" : null)">@(OperationalStatusDisplay.Label(value) ?? value)</option>
        }
      </select>
    </label>
    <label>Recovery
      <select name="recovery">
        <option value="">Any</option>
        <option value="present" selected="@(query.Recovery == "present" ? "selected" : null)">Session retained</option>
        <option value="absent" selected="@(query.Recovery == "absent" ? "selected" : null)">No retained session</option>
      </select>
    </label>
    @if (Model.Capabilities.ContextApproval)
    {
      <label>Context
        <select name="contextState">
          <option value="">Any</option>
          <option value="approved" selected="@(query.ContextState == "approved" ? "selected" : null)">Approved projection</option>
          <option value="needs-review" selected="@(query.ContextState == "needs-review" ? "selected" : null)">Needs review</option>
          <option value="unknown" selected="@(query.ContextState == "unknown" ? "selected" : null)">Unknown</option>
        </select>
      </label>
    }
    <label>Updated
      <select name="updatedWithin">
        <option value="">Any time</option>
        <option value="today" selected="@(query.UpdatedWithin == "today" ? "selected" : null)">Today</option>
        <option value="7d" selected="@(query.UpdatedWithin == "7d" ? "selected" : null)">Last 7 days</option>
        <option value="30d" selected="@(query.UpdatedWithin == "30d" ? "selected" : null)">Last 30 days</option>
      </select>
    </label>
    @if (Model.LocalClaimFiltersAvailable)
    {
      <label>Claimant kind
        <select name="claimKind">
          <option value="">Any</option>
          @foreach (var value in new[] { "unclaimed", "human", "agent", "automation", "unknown" })
          {
            <option value="@value" selected="@(query.ClaimKind == value ? "selected" : null)">@char.ToUpperInvariant(value[0])@value[1..]</option>
          }
        </select>
      </label>
      <label>Claim state
        <select name="claimState">
          <option value="">Any</option>
          <option value="unclaimed" selected="@(query.ClaimState == "unclaimed" ? "selected" : null)">Unclaimed</option>
          <option value="current" selected="@(query.ClaimState == "current" ? "selected" : null)">Owned here</option>
          <option value="other" selected="@(query.ClaimState == "other" ? "selected" : null)">Owned elsewhere</option>
        </select>
      </label>
    }
  </form>

  @if (query.HasFilters)
  {
    <div class="active-filter-chips" aria-label="Active Operations filters">
      @foreach (var entry in new[]
      {
        ("search", "Search", query.Search),
        ("agent", "Requested agent", query.Agent),
        ("priority", "Priority", query.Priority),
        ("workflowStatus", "Status", query.WorkflowStatus),
        ("operationalStatus", "Operational", query.OperationalStatus),
        ("recovery", "Recovery", query.Recovery),
        ("contextState", "Context", query.ContextState),
        ("updatedWithin", "Updated", query.UpdatedWithin),
        ("claimKind", "Claimant", query.ClaimKind),
        ("claimState", "Claim", query.ClaimState)
      })
      {
        if (entry.Item3 is not null)
        {
          <button type="button" data-clear-operations-filter="@entry.Item1">@entry.Item2: @entry.Item3 <span aria-hidden="true">×</span></button>
        }
      }
      <button type="button" data-clear-operations-filters>Clear all</button>
    </div>
  }

  @if (Model.IsTruncated)
  {
    <output class="operations-limit-notice">Showing matches from the first 100 items returned by the backend. Refine the filters to narrow the view.</output>
  }

  <div class="operations-grid">
    <section id="operational-items" class="operations-card">
      <header>
        <h3>Operational items</h3>
        <div class="operations-card-heading-actions">
          @if (query.Sort != ItemSort.Default)
          {
            <button type="button" data-operations-sort="default"
                    data-operations-sort-field="number">Default order</button>
          }
          else
          {
            <span>Operational priority</span>
          }
          <span class="operations-item-count">@Model.Items.Count</span>
        </div>
      </header>
      @if (Model.OperationsErrorCode is not null)
      {
        <div class="error" role="alert"><strong>@Model.OperationsErrorCode</strong> @Model.OperationsErrorMessage</div>
      }
      else if (Model.Items.Count == 0)
      {
        <p class="empty-state">@(query.HasFilters ? "No operational items match the current filters." : "No work items were returned by the configured backend.")</p>
      }
      else
      {
        <div class="table-scroll">
          <table>
            <colgroup>
              <col class="operations-col-item">
              <col class="operations-col-title">
              <col class="operations-col-workflow-status">
              <col class="operations-col-priority">
              <col class="operations-col-agent">
              <col class="operations-col-updated">
              <col class="operations-col-operational-status">
              <col class="operations-col-recovery">
              @if (Model.Capabilities.ContextApproval)
              {
                <col class="operations-col-context">
              }
              @if (hasActions)
              {
                <col class="operations-col-actions">
              }
            </colgroup>
            <thead>
              <tr>
                <th aria-sort="@SortState(ItemSortField.Number)">
                  <button type="button" class="operations-sort-button"
                          data-operations-sort="@NextSort(ItemSortField.Number)"
                          data-operations-sort-field="number">
                    Item <span aria-hidden="true">@SortIndicator(ItemSortField.Number)</span>
                  </button>
                </th>
                <th aria-sort="@SortState(ItemSortField.Title)">
                  <button type="button" class="operations-sort-button"
                          data-operations-sort="@NextSort(ItemSortField.Title)"
                          data-operations-sort-field="title">
                    Title <span aria-hidden="true">@SortIndicator(ItemSortField.Title)</span>
                  </button>
                </th>
                <th aria-sort="@SortState(ItemSortField.Status)">
                  <button type="button" class="operations-sort-button"
                          data-operations-sort="@NextSort(ItemSortField.Status)"
                          data-operations-sort-field="status">
                    Workflow status <span aria-hidden="true">@SortIndicator(ItemSortField.Status)</span>
                  </button>
                </th>
                <th aria-sort="@SortState(ItemSortField.Priority)">
                  <button type="button" class="operations-sort-button"
                          data-operations-sort="@NextSort(ItemSortField.Priority)"
                          data-operations-sort-field="priority">
                    Priority <span aria-hidden="true">@SortIndicator(ItemSortField.Priority)</span>
                  </button>
                </th>
                <th aria-sort="@SortState(ItemSortField.Agent)">
                  <button type="button" class="operations-sort-button"
                          data-operations-sort="@NextSort(ItemSortField.Agent)"
                          data-operations-sort-field="agent">
                    Requested agent <span aria-hidden="true">@SortIndicator(ItemSortField.Agent)</span>
                  </button>
                </th>
                <th aria-sort="@SortState(ItemSortField.Updated)">
                  <button type="button" class="operations-sort-button"
                          data-operations-sort="@NextSort(ItemSortField.Updated, defaultDescending: true)"
                          data-operations-sort-field="updated">
                    Updated <span aria-hidden="true">@SortIndicator(ItemSortField.Updated)</span>
                  </button>
                </th>
                <th aria-sort="@SortState(ItemSortField.Operational)">
                  <button type="button" class="operations-sort-button"
                          data-operations-sort="@NextSort(ItemSortField.Operational)"
                          data-operations-sort-field="operational">
                    Operational status <span aria-hidden="true">@SortIndicator(ItemSortField.Operational)</span>
                  </button>
                </th>
                <th>Recovery</th>
                @if (Model.Capabilities.ContextApproval)
                {
                  <th>Context</th>
                }
                @if (hasActions)
                {
                  <th class="operations-action-cell">Actions</th>
                }
              </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
              <tr data-item-id="@item.Id">
                <td class="operations-item-id"><code>@item.Id</code></td>
                <td>
                  @if (item.Url is not null)
                  {
                    <a href="@item.Url" target="_blank" rel="noreferrer">@item.Title</a>
                  }
                  else
                  {
                    <span>@item.Title</span>
                  }
                </td>
                <td>@(item.Status ?? "—")</td>
                <td>@(item.Priority ?? "—")</td>
                <td>@(item.RequestedAgent ?? "—")</td>
                <td>@if (item.UpdatedAt is { } updatedAt){<time datetime="@updatedAt.ToString("O")" data-relative-time data-time-label="Updated" title="Updated @updatedAt.ToUniversalTime().ToString("u")">Updated @RelativeTimeDisplay.Label(updatedAt)</time>}else{<text>—</text>}</td>
                <td>@(OperationalStatusDisplay.Label(item.OperationalStatus) ?? "—")</td>
                <td>@(item.Recovery ?? "—")</td>
                @if (Model.Capabilities.ContextApproval)
                {
                  <td class="context-approval-cell">
                    <span id="context-approval-state-@item.AutomationKey"
                          class="state-pill context-approval-@item.ContextApprovalAppearance"
                          title="@item.ContextApprovalTitle">@item.ContextApprovalLabel</span>
                  </td>
                }
                @if (hasActions)
                {
                  <td class="operations-action-cell">
                    <partial name="Shared/_CardActions"
                             model="new ActionListView(item.Id, item.Id, item.EffectiveSessionActions)" />
                    @if (Model.Capabilities.ContextApproval)
                    {
                      <button id="context-approval-inspect-@item.AutomationKey"
                              type="button"
                              data-panel-loading-label="Loading context approval…"
                              hx-get="/?handler=ContextApproval&amp;id=@Uri.EscapeDataString(item.Id)"
                              hx-target="#item-panel"
                              hx-swap="innerHTML"
                              hx-request='{"timeout":130000}'>Inspect</button>
                    }
                  </td>
                }
              </tr>
            }
            </tbody>
          </table>
        </div>
      }
    </section>

    <section id="worker-processes" class="operations-card worker-processes-card">
      <header>
        <div>
          <h3>Local worker processes</h3>
          <span>Workers are owned by the web-console process or terminal/service that started them.</span>
        </div>
        <div class="worker-heading-actions">
          <span>@Model.Workers.Count</span>
          @if (Model.HostedWorkerAvailable)
          {
            <form method="post"
                  hx-post="/?handler=StartHostedWorker"
                  hx-target="#operations-content"
                  hx-swap="outerHTML"
                  hx-include="#operations-filters"
                  hx-disabled-elt="#start-hosted-worker"
                  data-confirm-title="Start a worker in this web console?"
                  data-confirm-message="The worker is owned by the wrighty web process and continues if this browser tab closes. It stops when the web process stops."
                  data-confirm-action="Start worker">
              @Html.AntiForgeryToken()
              <button id="start-hosted-worker" class="primary request-button" type="submit">Start worker</button>
            </form>
          }
        </div>
      </header>
      @if (Model.Workers.Count == 0)
      {
        <p class="empty-state">No worker process is registered for this repository configuration.</p>
      }
      else
      {
        <div class="worker-list">
        @foreach (var worker in Model.Workers)
        {
          var instance = worker.Instance;
          var hostedRun = Model.HostedWorkers.FirstOrDefault(value => value.RunId == instance.RunId);
          var ownedHere = hostedRun is not null;
          var externallyStarted = instance.HostKind == WorkerHostKind.CliProcess;
          var externallyOwned = !externallyStarted && !ownedHere;
          var verified = worker.Liveness == WorkerInstanceLiveness.Running;
          var canControl = verified && instance.ControlProtocolVersion == 1 &&
            instance.SupportedStopModes is not null;
          var isBusy = instance.CurrentItemId is not null;
          var originDescription = "Hosted by another web console";
          var originLabel = "Web console";
          string stopTitle;
          var stopPrefix = string.Empty;
          var interruptPrefix = string.Empty;
          if (externallyStarted)
          {
            originDescription = "Started outside the web console";
            originLabel = "External";
            stopTitle = "Stop externally started worker?";
            stopPrefix = "Important: this worker was started outside the web console. Wrighty will ask that terminal or service-owned process to stop cooperatively. If a service manager restarts it, stop the service there too. ";
            interruptPrefix = "Important: this worker was started outside the web console. ";
          }
          else if (ownedHere)
          {
            originDescription = "Hosted by this web console";
            stopTitle = isBusy ? "Stop after the current item?" : "Stop worker?";
          }
          else
          {
            stopTitle = "Stop worker hosted by another web console?";
            stopPrefix = "Important: another web-console process owns this worker. Wrighty will ask that process to stop it cooperatively. ";
            interruptPrefix = "Important: another web-console process owns this worker. ";
          }
          var stopMessage = stopPrefix + (isBusy
            ? "The agent session will be allowed to finish, including Wrighty's bookkeeping, and the worker will not claim another item."
            : "The idle worker will stop without claiming another item.");
          var stateLabel = hostedRun?.State == WebHostedWorkerState.WaitingForWorkspace
            ? "Waiting for workspace"
            : instance.State switch
          {
            WorkerInstanceState.PreparingItem => "Worker preparing",
            WorkerInstanceState.RunningItem => "Agent working",
            WorkerInstanceState.Draining => "Draining",
            WorkerInstanceState.StoppingNow => "Stopping now",
            WorkerInstanceState.Finalizing => "Finalizing",
            WorkerInstanceState.Stopping => "Stopping",
            _ => "Idle"
          };
          <article id="worker-instance-@worker.Instance.RunId"
                   class="worker-row worker-@worker.Liveness.ToString().ToLowerInvariant()">
            <div class="worker-card-title">
              <strong>@instance.InvocationSummary</strong>
              <span class="worker-origin">@originDescription</span>
            </div>
            <span class="state-pill state-@worker.Liveness.ToString().ToLowerInvariant()">@worker.Liveness</span>
            <dl class="worker-facts" aria-label="Worker information">
              <div><dt>Origin</dt><dd>@originLabel</dd></div>
              <div><dt>Process</dt><dd>PID @instance.ProcessId</dd></div>
              <div><dt>State</dt><dd>@(verified ? stateLabel : $"Last reported: {stateLabel}")</dd></div>
              <div><dt>Item</dt><dd>
                @if (instance.CurrentItemId is not null)
                {
                  <button class="worker-item-link"
                          type="button"
                          hx-get="/?handler=Item&id=@Uri.EscapeDataString(instance.CurrentItemId)"
                          hx-target="#item-panel"
                          hx-swap="innerHTML">@instance.CurrentItemId</button>
                }
                else { <span>—</span> }
              </dd></div>
              <div><dt>Agent</dt><dd>@(instance.CurrentAgent ?? (isBusy && instance.ControlProtocolVersion is null ? "Not reported by this worker version" : "—"))</dd></div>
            </dl>
            @if (canControl)
            {
              <div class="worker-controls">
                <form method="post"
                      hx-post="/?handler=StopWorker"
                      hx-target="#operations-content"
                      hx-swap="outerHTML"
                      hx-include="#operations-filters"
                      data-confirm-title="@stopTitle"
                      data-confirm-message="@stopMessage"
                      data-confirm-action="@(isBusy ? "Stop after current item" : "Stop worker")">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="runId" value="@instance.RunId">
                  <input type="hidden" name="processId" value="@instance.ProcessId">
                  <input type="hidden" name="processStartIdentity" value="@instance.ProcessStartIdentity">
                  <input type="hidden" name="hostKind" value="@instance.HostKind">
                  <input type="hidden" name="mode" value="Drain">
                  <button id="stop-worker-@instance.RunId" type="submit">@(isBusy ? "Stop after current item" : "Stop worker")</button>
                </form>
                @if (isBusy && instance.SupportedStopModes!.Contains(WorkerStopMode.Interrupt))
                {
                  <form method="post"
                        hx-post="/?handler=StopWorker"
                        hx-target="#operations-content"
                        hx-swap="outerHTML"
                        hx-include="#operations-filters"
                        data-confirm-title="Stop the active agent now?"
                        data-confirm-message="@(interruptPrefix)The agent process will be terminated. Wrighty will keep the item in its current workflow state, mark it needs attention, retain any session/workspace, and finish bookkeeping with a separate bounded finalizer."
                        data-confirm-action="Stop now"
                        data-confirm-tone="danger">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="runId" value="@instance.RunId">
                    <input type="hidden" name="processId" value="@instance.ProcessId">
                    <input type="hidden" name="processStartIdentity" value="@instance.ProcessStartIdentity">
                    <input type="hidden" name="hostKind" value="@instance.HostKind">
                    <input type="hidden" name="mode" value="Interrupt">
                    <button id="stop-now-worker-@instance.RunId" class="danger" type="submit">Stop now…</button>
                  </form>
                }
              </div>
            }
            else if (verified)
            {
              <small>This worker version does not advertise safe cooperative stop controls.</small>
            }
            @if (externallyStarted)
            {
              <small>Logs remain in the terminal or service that owns this worker.</small>
            }
            else if (externallyOwned)
            {
              <small>Logs remain in the web-console process that owns this worker.</small>
            }
            else
            {
              <small>This worker continues when the browser closes and stops with the web-console process.</small>
            }
            <small>heartbeat @instance.LastHeartbeatAt.ToLocalTime().ToString("g") · config @instance.ConfigurationRevision[..Math.Min(10, instance.ConfigurationRevision.Length)]</small>
            @if (worker.Detail is not null) { <small>@worker.Detail</small> }
            @if (hostedRun?.StartedAt is not null)
            {
              var hostedLogDescription = "Shows the latest 200 lifecycle events; repeated idle updates are consolidated. Agent prompts, responses, commands, environment, session IDs, stdout, and stderr are not retained in this log.";
              var hostedLogPanelId = $"hosted-worker-log-panel-{instance.RunId}";
              var hostedLogDescriptionId = $"hosted-worker-log-description-{instance.RunId}";
              <details id="@hostedLogPanelId" class="hosted-worker-log-panel"
                       data-hosted-worker-log-panel data-worker-run-id="@instance.RunId">
                <summary title="@hostedLogDescription" aria-describedby="@hostedLogDescriptionId">Hosted worker operational log</summary>
                <span id="@hostedLogDescriptionId" class="visually-hidden">@hostedLogDescription</span>
                <partial name="Shared/_HostedWorkerLog" model="hostedRun" />
              </details>
            }
          </article>
        }
        </div>
      }
    </section>
  </div>
</section>
