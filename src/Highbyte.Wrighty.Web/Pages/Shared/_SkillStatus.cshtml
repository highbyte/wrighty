@model Highbyte.Wrighty.Web.SkillStatusPageModel
@{
  var targets = Model.Targets();
  var targetAttentionCount = targets.Count(target => target.NeedsAttention);
  var attentionCount = Math.Max(targetAttentionCount, Model.ErrorCode is null ? 0 : 1);
  var hasIssues = attentionCount > 0;
  var missingTargetCount = targets.Count(target => target.IsMissing);
  var outdatedCount = Model.Installations.Count(installation =>
    installation.State == Highbyte.Wrighty.Web.WebSkillInstallationState.Outdated);
  var bundledVersion = Model.Installations.FirstOrDefault()?.BundledVersion ?? "unknown";
}
<section id="skill-status-region"
         hx-get="/?handler=SkillStatus"
         hx-trigger="wrighty:ready, wrighty:refresh"
         hx-swap="outerHTML">
  <details class="skill-status-menu@(hasIssues ? " has-issues" : " has-current")">
    <summary>
      <span>Agent skills</span>
      <span>@(hasIssues ? $"{attentionCount} attention" : "Current")</span>
    </summary>
    <div class="skill-status-popover">
      <header class="skill-status-popover-header">
        <div>
          <strong>Manage agent skills</strong>
          <span>Bundled version @bundledVersion</span>
        </div>
      </header>
      @if (Model.ErrorCode is not null)
      {
        <p class="error" role="alert"><strong>@Model.ErrorCode</strong> @Model.ErrorMessage</p>
      }
      <section class="skill-bulk-actions">
        <header>
          <strong>All skill targets</strong>
          <span>Bulk actions never overwrite or force-remove modified files.</span>
        </header>
        <div>
          <form class="skill-bulk-install-form"
                hx-post="/?handler=MaintainAllSkills"
                hx-target="#skill-status-region"
                hx-swap="outerHTML"
                hx-disabled-elt="find button, find select">
            @Html.AntiForgeryToken()
            <input type="hidden" name="operation" value="install">
            <label>
              Install scope
              <select class="select-compact" name="scope">
                <option value="user" selected>User (recommended)</option>
                <option value="project">Project</option>
              </select>
            </label>
            <button type="submit" class="button-compact" disabled="@(missingTargetCount == 0)">Install all missing</button>
          </form>
          <form hx-post="/?handler=MaintainAllSkills"
                hx-target="#skill-status-region"
                hx-swap="outerHTML"
                hx-disabled-elt="find button">
            @Html.AntiForgeryToken()
            <input type="hidden" name="operation" value="update">
            <button type="submit" class="button-compact" disabled="@(outdatedCount == 0)">Update all outdated</button>
          </form>
          @foreach (var scope in new[] { "user", "project" })
          {
            var scopeLabel = scope == "user" ? "User" : "Project";
            <form hx-post="/?handler=MaintainAllSkills"
                  hx-target="#skill-status-region"
                  hx-swap="outerHTML"
                  hx-disabled-elt="find button"
                  data-confirm-title="Uninstall all @scopeLabel skills?"
                  data-confirm-message="This removes every unmodified Wrighty skill installed at @scope scope. Modified or unrecognized content is never force-removed."
                  data-confirm-action="Uninstall all @scopeLabel skills"
                  data-confirm-tone="danger">
              @Html.AntiForgeryToken()
              <input type="hidden" name="operation" value="uninstall">
              <input type="hidden" name="scope" value="@scope">
              <button type="submit"
                      class="button-compact danger"
                      disabled="@(!Model.CanUninstallAll(scope))">Uninstall all @scopeLabel skills</button>
            </form>
          }
        </div>
      </section>
      <div class="skill-target-list">
        @foreach (var target in targets)
        {
          <section class="skill-target@(target.NeedsAttention ? " has-issues" : null)">
            <header>
              <div>
                <strong>@target.AgentLabel</strong>
                @if (target.AgentSelection.Contains(',', StringComparison.Ordinal))
                {
                  <span>Shared physical installation</span>
                }
              </div>
              <span>@(target.IsMissing ? "Missing" : target.IsDuplicate ? "Duplicate" : target.NeedsAttention ? "Attention" : "Current")</span>
            </header>
            @if (target.IsDuplicate)
            {
              <p class="warning">
                Both scopes are installed. Agent hosts resolve duplicate names differently;
                uninstall the unintended copy.
              </p>
            }
            <div class="skill-scope-grid">
              @foreach (var installation in target.Installations)
              {
                var stateToken = installation.State.ToString().ToLowerInvariant();
                var scopeLabel = installation.Scope == "user" ? "User" : "Project";
                <section class="skill-scope-row">
                  <header>
                    <strong>@scopeLabel@(installation.Scope == "user" ? " (recommended)" : null)</strong>
                    <span class="skill-installation-state state-@stateToken">@installation.State</span>
                  </header>
                  <code title="@installation.Path">@installation.Path</code>
                  @if (installation.State == Highbyte.Wrighty.Web.WebSkillInstallationState.Missing)
                  {
                    <p>Not installed at this scope.</p>
                    @if (target.IsMissing)
                    {
                      <form hx-post="/?handler=InstallSkill"
                            hx-target="#skill-status-region"
                            hx-swap="outerHTML"
                            hx-disabled-elt="find button">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="agentSelection" value="@installation.AgentSelection">
                        <input type="hidden" name="scope" value="@installation.Scope">
                        <button type="submit" class="button-compact">Install @scopeLabel</button>
                      </form>
                    }
                    else
                    {
                      <span class="skill-action-unavailable">The other scope is active.</span>
                    }
                  }
                  else
                  {
                    <p>
                      Installed @(installation.InstalledVersion ?? "unknown"); bundled
                      @installation.BundledVersion.
                    </p>
                    @if (installation.State is
                      Highbyte.Wrighty.Web.WebSkillInstallationState.Modified or
                      Highbyte.Wrighty.Web.WebSkillInstallationState.Malformed)
                    {
                      <p>
                        Inspect this copy with
                        <code>wrighty skill check --agent @installation.AgentSelection --scope @installation.Scope</code>.
                        The web console will not overwrite or force-remove it.
                      </p>
                    }
                    else
                    {
                      <div class="skill-installation-actions">
                        @if (installation.State == Highbyte.Wrighty.Web.WebSkillInstallationState.Outdated)
                        {
                          <form hx-post="/?handler=UpdateSkill"
                                hx-target="#skill-status-region"
                                hx-swap="outerHTML"
                                hx-disabled-elt="find button">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="agentSelection" value="@installation.AgentSelection">
                            <input type="hidden" name="scope" value="@installation.Scope">
                            <button type="submit" class="button-compact">Update @scopeLabel</button>
                          </form>
                        }
                        <form hx-post="/?handler=UninstallSkill"
                              hx-target="#skill-status-region"
                              hx-swap="outerHTML"
                              hx-disabled-elt="find button"
                              data-confirm-title="Uninstall the @scopeLabel skill for @installation.AgentLabel?"
                              data-confirm-message="This removes the recognized Wrighty skill at @installation.Path."
                              data-confirm-action="Uninstall @scopeLabel skill"
                              data-confirm-tone="danger">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="agentSelection" value="@installation.AgentSelection">
                          <input type="hidden" name="scope" value="@installation.Scope">
                          <button type="submit" class="button-compact danger">Uninstall @scopeLabel</button>
                        </form>
                      </div>
                    }
                  }
                </section>
              }
            </div>
          </section>
        }
      </div>
    </div>
  </details>
</section>
@if (Model.Notice is not null)
{
  <output id="page-notice-region"
          class="notice"
          role="status"
          aria-live="polite"
          hx-swap-oob="outerHTML">@Model.Notice</output>
}
