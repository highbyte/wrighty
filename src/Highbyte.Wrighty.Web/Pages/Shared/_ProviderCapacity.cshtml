@model ProviderCapacityPageModel
@{
  var activeProbeCount = Model.Providers.Count(provider => provider.ProbeInProgress);
  var unavailableCount = Model.Providers.Count(provider =>
    provider.State == ProviderCapacityState.UnavailableUntil);
  var availableCount = Model.Providers.Count(provider =>
    provider.State == ProviderCapacityState.Available);
  var simulatedCount = Model.Providers.Count(provider => provider.Simulated);
}
<section id="provider-capacity-region"
         data-revision="@Model.Revision"
         hx-get="/?handler=ProviderCapacity"
         hx-trigger="wrighty:ready, wrighty:refresh"
         hx-swap="outerHTML">
  @if (Model.Providers.Count == 0 && Model.ErrorCode is not null)
  {
    <p class="error" role="alert"><strong>@Model.ErrorCode</strong> @Model.ErrorMessage</p>
  }
  @if (Model.Providers.Count > 0)
  {
    <details class="provider-capacity-menu@(availableCount > 0 ? " has-available" : null)@(activeProbeCount > 0 || unavailableCount > 0 || simulatedCount > 0 ? " has-issues" : null)">
      <summary>
        <span>Agent capacity</span>
        <span>
          @if (availableCount > 0 && (activeProbeCount > 0 || unavailableCount > 0))
          {
            <text>@availableCount available</text>
          }
          @if (availableCount > 0 && activeProbeCount > 0)
          {
            <text> · </text>
          }
          @if (activeProbeCount > 0)
          {
            <text>@activeProbeCount probing</text>
          }
          @if ((availableCount > 0 || activeProbeCount > 0) && unavailableCount > 0)
          {
            <text> · </text>
          }
          @if (unavailableCount > 0)
          {
            <text>@unavailableCount unavailable</text>
          }
          @if (activeProbeCount == 0 && unavailableCount == 0)
          {
            <text>Available</text>
          }
          @if (simulatedCount > 0)
          {
            <text> · @simulatedCount simulated</text>
          }
        </span>
      </summary>
      <div class="provider-capacity-popover">
        @if (Model.Notice is not null)
        {
          <p class="notice" role="status">@Model.Notice</p>
        }
        @if (Model.ErrorCode is not null)
        {
          <p class="error" role="alert"><strong>@Model.ErrorCode</strong> @Model.ErrorMessage</p>
        }
        <header class="provider-capacity-popover-header">
          <div>
            <strong>Agent capacity</strong>
            <span>Real probes may consume subscription usage; repository simulations do not. Neither claims a work item.</span>
          </div>
          @if (activeProbeCount > 0)
          {
            <button type="button" class="button-compact"
                    title="Wait for the active capacity probe to finish."
                    disabled>Probe all</button>
          }
          else
          {
            <form hx-post="/?handler=ProbeAllProviders"
                  hx-target="#provider-capacity-region"
                  hx-swap="outerHTML"
                  hx-request='{"timeout":130000}'
                  hx-disabled-elt="find button"
                  data-confirm-title="Probe all agent capacities?"
                  data-confirm-message="A real probe starts one small vendor request per configured agent and may consume subscription usage. Configured repository simulations do not start the vendor CLI. Neither path claims a work item."
                  data-confirm-action="Probe all">
              @Html.AntiForgeryToken()
              <button type="submit" class="button-compact">Probe all</button>
            </form>
          }
        </header>
        <div class="provider-capacity-grid">
          @foreach (var provider in Model.Providers)
          {
            <section class="provider-capacity-row">
              <header>
                <strong>@provider.AgentLabel</strong>
                <span class="provider-capacity-state">
                  @(provider.ProbeInProgress
                    ? "Probe in progress"
                    : provider.State == ProviderCapacityState.UnavailableUntil
                      ? "Unavailable"
                      : "Available")
                  @if (provider.Simulated)
                  {
                    <text> · Simulated</text>
                  }
                </span>
              </header>
              <span>
                @if (provider.ProbeInProgress)
                {
                  <text>A single capacity probe is in progress</text>
                }
                else if (provider.State == ProviderCapacityState.UnavailableUntil)
                {
                  <text>Automatic work is paused</text>
                }
                else
                {
                  <text>No capacity block is recorded</text>
                }
                @if (provider.Until is { } until)
                {
                  <text> until @until.ToLocalTime().ToString("g")</text>
                }.
              </span>
              @if ((provider.HasCapacityFailure || provider.Simulated) &&
                   !string.IsNullOrWhiteSpace(provider.Reason))
              {
                <span>@provider.Reason</span>
              }
              @if (provider.ProbeInProgress)
              {
                <button type="button" class="button-compact" disabled>Probe in progress</button>
              }
              else
              {
                <form hx-post="/?handler=ProbeProvider"
                      hx-target="#provider-capacity-region"
                      hx-swap="outerHTML"
                      hx-request='{"timeout":130000}'
                      hx-disabled-elt="find button"
                      data-confirm-title="Probe @provider.AgentLabel capacity?"
                      data-confirm-message="A real probe starts a small vendor request and may consume subscription usage. A configured repository simulation does not start the vendor CLI. Neither path claims a work item."
                      data-confirm-action="Probe @provider.AgentLabel">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="agent" value="@provider.Agent">
                  <input type="hidden" name="surface" value="header">
                  <button type="submit" class="button-compact">Probe @provider.AgentLabel</button>
                </form>
              }
            </section>
          }
        </div>
      </div>
    </details>
  }
</section>
