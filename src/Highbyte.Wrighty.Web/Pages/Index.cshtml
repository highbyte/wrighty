@page
@model Highbyte.Wrighty.Web.Pages.IndexModel
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="wrighty-auth" content="@Model.WebAuthenticationMode">
  <meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"historyCacheSize":0,"selfRequestsOnly":true,"includeIndicatorStyles":false,"timeout":3000}'>
  <title>Wrighty web console</title>
  <link rel="stylesheet" href="/assets/wrighty.css">
  <script defer src="/assets/htmx.js"></script>
  <script defer src="/assets/highlight-yaml.js"></script>
  <script type="module" src="/assets/app.js"></script>
</head>
<body>
  <header class="app-header">
    <div class="app-identity">
      <span class="eyebrow">@Model.BackendLabel</span>
      <h1>Wrighty</h1>
      <span class="host-workspace-identity"
            aria-label="Host @Model.LocalHostName, workspace @Model.WorkspacePath">
        <span id="local-host-name" class="local-host-name">@Model.LocalHostName</span>
        <span aria-hidden="true"> · </span>
        <span id="workspace-path"
              class="workspace-path"
              title="@Model.WorkspacePath">@Model.WorkspaceDisplayPath</span>
      </span>
    </div>
    <div class="app-header-status">
      <section id="worker-summary-region"
               hx-get="/?handler=WorkerSummary"
               hx-trigger="wrighty:ready, wrighty:worker-summary-refresh"
               hx-swap="outerHTML">Loading workers…</section>
      @if (Model.AgentManagementAvailable)
      {
        <section id="agents-region"
                 hx-get="/?handler=Agents"
                 hx-trigger="wrighty:ready, wrighty:agents-refresh"
                 hx-sync="#agents-region:replace"
                 hx-swap="outerHTML">Loading agents…</section>
      }
      <div class="connection-tools">
        <div id="connection-status" class="connection" role="status">Connecting…</div>
        <button id="copy-access-link"
                class="access-link-button"
                type="button"
                title="Copy a URL that opens this web console in another browser">Copy access link</button>
        <output id="copy-access-link-feedback"
                class="visually-hidden"
                aria-live="polite"></output>
      </div>
    </div>
  </header>
  <nav id="page-tabs" class="tabs page-tabs" role="tablist" aria-label="Console sections">
    @if (Model.Capabilities.LocalBoard)
    {
      <button id="tab-board" class="tab active" type="button" role="tab"
              aria-selected="true"
              aria-controls="board-panel"
              data-section="board">Board <span id="tab-attention-badge" class="tab-badge" hidden></span></button>
    }
    <button id="tab-operations" class="tab@(Model.Capabilities.LocalBoard ? "" : " active")" type="button" role="tab"
            aria-selected="@(Model.Capabilities.LocalBoard ? "false" : "true")"
            tabindex="@(Model.Capabilities.LocalBoard ? "-1" : "0")"
            aria-controls="operations-panel"
            data-section="operations">Operations @if (!Model.Capabilities.LocalBoard)
            {<span id="tab-attention-badge" class="tab-badge" hidden></span>}</button>
    <button id="tab-settings" class="tab" type="button" role="tab"
            aria-selected="false"
            tabindex="-1"
            aria-controls="settings-panel"
            data-section="settings">Settings <span id="tab-settings-unsaved" class="tab-unsaved"
            title="Go to the first unsaved settings section" hidden>Unsaved</span></button>
  </nav>
  <section class="page-notifications" aria-label="Notifications">
    <output id="page-notice-region"
            aria-live="polite"
            hidden></output>
  </section>
  <main>
    @if (Model.Capabilities.LocalBoard)
    {
      <div id="board-panel" role="tabpanel" aria-labelledby="tab-board">
        <section class="toolbar" aria-label="Board controls">
          <div class="board-toolbar-row">
          <form id="board-filters" hx-get="/?handler=Board" hx-target="#board-content" hx-swap="outerHTML"
                hx-disabled-elt="#reset-board-view">
            <label>Search <input id="board-search" name="q" type="search" autocomplete="off" placeholder="ID, title, status, or priority"></label>
            <label>Scope
              <select name="scope">
                <option value="active">Active</option>
                <option value="archived">Archived</option>
                <option value="all">All</option>
              </select>
            </label>
            <label>Sort
              <span class="sort-control">
              <select id="board-sort" name="sort" data-sort-select aria-label="Sort all board columns">
                <option value="default">Operational priority</option>
                <option value="updated:desc">Recently updated</option>
                <option value="updated:asc">Least recently updated</option>
                <option value="created:desc">Newest created</option>
                <option value="created:asc">Oldest created</option>
                <option value="priority:asc">Priority, highest first</option>
                <option value="priority:desc">Priority, lowest first</option>
                <option value="title:asc">Title A–Z</option>
                <option value="title:desc">Title Z–A</option>
                <option value="number:asc">Item number, ascending</option>
                <option value="number:desc">Item number, descending</option>
              </select>
              <button type="button" class="sort-direction" data-sort-direction-for="board-sort"
                      aria-pressed="false" aria-label="Default ordering has no direction toggle" disabled>↕</button>
              </span>
            </label>
            <details id="board-filter-menu" class="board-filter-menu">
              <summary aria-controls="board-filter-fields">
                Filters <span class="board-filter-count" data-board-filter-count hidden aria-hidden="true"></span>
              </summary>
              <fieldset id="board-filter-fields" class="board-filter-fields">
                <legend class="visually-hidden">Board filters</legend>
                <header class="board-filter-heading">
                  <strong>Filters</strong>
                  <span class="board-filter-heading-actions">
                    <button class="board-filter-clear" type="button" data-clear-board-filters>Clear all</button>
                    <button id="close-board-filters" class="board-filter-close" type="button"
                            data-close-board-filters aria-label="Close filters">
                      <span aria-hidden="true">×</span>
                    </button>
                  </span>
                </header>
                <label>Claimant kind
                  <select name="claimKind">
                    <option value="">Any</option>
                    <option value="unclaimed">Unclaimed</option>
                    <option value="human">Human</option>
                    <option value="agent">Agent</option>
                    <option value="automation">Automation</option>
                    <option value="unknown">Unknown</option>
                  </select>
                </label>
                <label>Agent
                  <select id="board-agent-filter" name="agent"
                          title="Filters by the item's associated agent: active worker, retained session, or configured agent policy."
                          aria-describedby="board-agent-filter-help">
                    <option value="">Any</option>
                    @foreach (var agent in Model.AgentOptions())
                    {
                      <option value="@agent.Id">@agent.DisplayName</option>
                    }
                  </select>
                  <span id="board-agent-filter-help" class="visually-hidden">Filters by the item's associated agent: active worker, retained session, or configured agent policy.</span>
                </label>
                <label>Priority
                  <select id="board-priority-filter" name="priority">
                    <option value="">Any</option>
                    @foreach (var priority in Model.PriorityOptions)
                    {
                      <option value="@priority">@priority</option>
                    }
                  </select>
                </label>
                <label>Claim state
                  <select name="claimState">
                    <option value="">Any</option>
                    <option value="unclaimed">Unclaimed</option>
                    <option value="current">Owned here</option>
                    <option value="other">Owned elsewhere</option>
                  </select>
                </label>
                <label>Updated
                  <select name="updatedWithin">
                    <option value="">Any time</option>
                    <option value="today">Today</option>
                    <option value="7d">Last 7 days</option>
                    <option value="30d">Last 30 days</option>
                  </select>
                </label>
              </fieldset>
            </details>
            <button id="reset-board-view" type="button" data-reset-board-view>Reset view</button>
            <button type="button" id="refresh-board">Refresh</button>
          </form>
          <button type="button"
                  id="new-board-item"
                  class="primary board-create-action"
                  hx-get="/?handler=Create"
                  hx-target="#item-panel"
                  hx-swap="innerHTML">New item</button>
          </div>
          <p id="filter-status" class="filter-status" role="status" aria-live="polite"></p>
        </section>
        <section id="board-content" class="board-loading"
                 aria-live="polite"
                 hx-get="/?handler=Board"
                 hx-trigger="wrighty:ready, wrighty:refresh"
                 hx-include="#board-filters"
                 hx-swap="outerHTML">Loading board…</section>
      </div>
    }
    <div id="operations-panel" role="tabpanel" aria-labelledby="tab-operations"
         hidden="@(Model.Capabilities.LocalBoard ? "hidden" : null)">
      <section id="operations-content"
               class="operations-loading"
               aria-live="polite"
               hx-get="/?handler=Operations"
               hx-trigger="wrighty:ready, wrighty:refresh from:body, wrighty:operations-refresh"
               hx-swap="outerHTML"
               hx-request='{"timeout":130000}'>Loading operations…</section>
    </div>
    <div id="settings-panel" role="tabpanel" aria-labelledby="tab-settings" hidden>
      <section id="settings-content"
               class="operations-loading"
               aria-live="polite"
               hx-get="/?handler=Settings"
               hx-trigger="wrighty:ready"
               hx-swap="outerHTML"
               hx-request='{"timeout":130000}'>Loading settings…</section>
    </div>
  </main>
  <aside id="item-panel" class="item-panel" role="dialog" aria-modal="false" aria-label="Details" tabindex="-1"></aside>
  <dialog id="confirmation-dialog"
          class="confirmation-dialog"
          aria-labelledby="confirmation-dialog-title"
          aria-describedby="confirmation-dialog-message">
    <form method="dialog" class="confirmation-dialog-card">
      <header class="confirmation-dialog-header">
        <h2 id="confirmation-dialog-title">Confirm action</h2>
        <button id="confirmation-dialog-close"
                class="confirmation-dialog-close"
                type="submit"
                value="cancel"
                aria-label="Close confirmation">×</button>
      </header>
      <p id="confirmation-dialog-message" class="confirmation-dialog-message"></p>
      <footer class="confirmation-dialog-actions">
        <button id="confirmation-dialog-cancel"
                type="submit"
                value="cancel"
                autofocus>Cancel</button>
        <button id="confirmation-dialog-accept"
                class="primary"
                type="button">Continue</button>
      </footer>
    </form>
  </dialog>
</body>
</html>
